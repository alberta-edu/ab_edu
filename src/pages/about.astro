---
import Base from '../layouts/Base.astro';
import { SUBJECTS, SITE_NAME } from '../site.ts';
import { curriculum } from '../lib/content.ts';
import { href } from '../lib/url.ts';

// "Implemented September 2023." -> "September 2023"
const sources = SUBJECTS.map((s) => {
  const c = curriculum(5, s.slug);
  const since = c.implemented?.replace(/^Implemented\s+/i, '').replace(/\.$/, '') ?? null;
  return { name: s.name, since };
});
---
<Base
  title="About: how AB Edu follows the Alberta curriculum"
  description="How AB Edu lessons and practice are matched to Alberta's K-6 program of studies, how content is checked, and how your privacy is protected."
  path="about/"
>
  <div class="container container--narrow">
    <header class="page-hero">
      <p class="page-hero__eyebrow">About</p>
      <h1>How {SITE_NAME} works</h1>
      <p class="page-hero__lede">Free, independent learning for Alberta students and families.</p>
    </header>
    <div class="prose stack">
      <h2>Matched to the curriculum</h2>
      <ul>
        <li>Every topic teaches one outcome from Alberta's program of studies.</li>
        <li>Open <strong>“Alberta curriculum: what this page covers”</strong> on a topic to see it.</li>
        <li>
          The four subjects on the Provincial Achievement Tests:
          <ul>
            {sources.map((s) => (
              <li>
                <strong>{s.name}</strong>{s.since && <>, in use since <span class="nowrap">{s.since}</span></>}
                {s.name === 'Social Studies' && <>{' '}<span class="nowrap">(new: ancient civilizations)</span></>}
              </li>
            ))}
          </ul>
        </li>
        <li>Outcomes are © Government of Alberta, quoted from <a href="https://curriculum.learnalberta.ca/curriculum/en" rel="noopener">New LearnAlberta</a>.</li>      </ul>

      <h2>How it's checked</h2>
      <ul>
        <li>A program checks every lesson and problem against its outcome.</li>
        <li>A second AI solved every problem blind, to check answers and grade level.</li>
        <li>Wrong choices are common mistakes, each with an explanation.</li>
        <li>Lessons, passages and visuals are original.</li>
        <li>No AI runs while you use the site.</li>
      </ul>

      <h2 id="credits">Credits</h2>
      <ul>
        <li>Built with <a href="https://www.anthropic.com/claude" rel="noopener">Claude</a>, an AI model by Anthropic.</li>
        <li>Claude wrote the lessons, problems, visuals and code.</li>
        <li>The site's owner guided and reviewed it.</li>
      </ul>

      <h2 id="privacy">Privacy</h2>
      <ul>
        <li>No accounts, ads, cookies or trackers.</li>
        <li>Progress stays in your browser only.</li>
        <li>Clearing browser data erases it. Keep a copy with <a href={href('progress/#backup')}>Save backup file</a>.</li>
      </ul>
    </div>
  </div>
</Base>
