---
import Base from '../layouts/Base.astro';
import { SUBJECTS, SITE_NAME } from '../site.ts';
import { curriculum } from '../lib/content.ts';
import { href } from '../lib/url.ts';

const sources = SUBJECTS.map((s) => {
  const c = curriculum(5, s.slug);
  return { name: s.name, implemented: c.implemented, source: c.source };
});
---
<Base
  title="About: how AB Edu follows the Alberta curriculum"
  description="How AB Edu lessons and practice are matched to Alberta's K-6 program of studies, how content is checked, and how your privacy is protected."
  path="about/"
>
  <div class="container container--narrow">
    <header class="page-hero">
      <p class="page-hero__eyebrow">About</p>
      <h1>How {SITE_NAME} works</h1>
      <p class="page-hero__lede">A free, independent learning site for Alberta students and families.</p>
    </header>
    <div class="prose stack">
      <h2>Matched to the program of studies</h2>
      <ul>
        <li>Every topic is built from one learning outcome in Alberta's program of studies.</li>
        <li>Open <strong>“Alberta curriculum: what this page covers”</strong> on any topic to see the official outcome.</li>
        <li>
          It covers the four subjects on Alberta's Provincial Achievement Tests:
          <ul>
            {sources.map((s) => <li><strong>{s.name}</strong>: {s.implemented}{s.name === 'Social Studies' && ' The new K–6 curriculum: Grade 5 now studies ancient civilizations.'}</li>)}
          </ul>
        </li>
        <li>Curriculum outcomes are © Government of Alberta, quoted for alignment only, from <a href="https://curriculum.learnalberta.ca/curriculum/en" rel="noopener">New LearnAlberta</a>.</li>
        <li>{SITE_NAME} is independent, and not affiliated with or endorsed by the Government of Alberta or Alberta Education.</li>
      </ul>

      <h2>How the content is made and checked</h2>
      <ul>
        <li>Lessons and problems are written with Claude, then checked before they are published.</li>
        <li>No AI runs on this site while you use it.</li>
        <li>A program recomputes every math answer with exact fractions.</li>
        <li>Every wrong answer choice is a real student mistake, with an explanation.</li>
        <li>A second AI model solved every problem without the answer key, and checked that none needs anything above Grade 5.</li>
        <li>Reading passages are original, written for this site.</li>
        <li>No child or teacher has tried the problems yet.</li>
      </ul>

      <h2 id="credits">Credits</h2>
      <p>
        Built with <a href="https://www.anthropic.com/claude" rel="noopener">Claude</a>, an AI model made by
        Anthropic. Claude wrote the lessons, problems, visuals and code, guided and reviewed by the site’s owner.
      </p>

      <h2 id="privacy">Privacy</h2>
      <ul>
        <li>No accounts, ads, cookies or trackers.</li>
        <li>Your progress is saved only in your own browser (localStorage), and never sent anywhere.</li>
        <li>Clearing your browser data erases it. To keep it, use <a href={href('progress/#backup')}>Save backup file</a>.</li>
      </ul>
    </div>
  </div>
</Base>
