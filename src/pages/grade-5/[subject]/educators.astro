---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import { conceptsFor, conceptPath } from '../../../lib/content.ts';
import { notesFor, subjectGuide, type SubjectGuide } from '../../../lib/educator.ts';
import { md, mdInline } from '../../../lib/render.ts';
import { SUBJECTS, type SubjectInfo } from '../../../site.ts';
import { href, absolute } from '../../../lib/url.ts';

export function getStaticPaths() {
  return SUBJECTS.flatMap((s) => {
    const guide = subjectGuide(s.slug);
    return guide ? [{ params: { subject: s.slug }, props: { subject: s, guide } }] : [];
  });
}
const { subject, guide: g } = Astro.props as { subject: SubjectInfo; guide: SubjectGuide };
const topics = conceptsFor(subject.slug).filter((c) => notesFor(c));
const path = `grade-5/${subject.slug}/educators/`;
const description = `How to teach Grade 5 ${subject.name} in a fun and engaging way: small shifts, routines and teaching notes for every Alberta curriculum topic.`.slice(0, 160);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'LearningResource',
    name: `Teaching Grade 5 ${subject.name}`,
    description,
    url: absolute(path),
    inLanguage: 'en-CA',
    isAccessibleForFree: true,
    educationalLevel: 'Grade 5',
    learningResourceType: 'Teacher guide',
    audience: { '@type': 'EducationalAudience', educationalRole: 'teacher' },
    about: subject.name,
  },
];
---
<Base title={`Teaching Grade 5 ${subject.name}`} description={description} path={path} subject={subject.slug} jsonLd={jsonLd}>
  <div class="container ed">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href={href('educators/')}>For educators</a></li>
        <li aria-current="page">{subject.name}</li>
      </ol>
    </nav>
    <header class="page-hero">
      <p class="page-hero__eyebrow">For teachers and parents · Grade 5</p>
      <h1>Teaching {subject.name}</h1>
      <div class="page-hero__lede" set:html={md(g.promise)} />
      <div class="control-row">
        <a class="btn btn--ghost" href={href(`grade-5/${subject.slug}/`)}>See the student topics</a>
      </div>
    </header>

    <div class="ed-sections">
      <section>
        <h2 class="ed-heading"><span aria-hidden="true">🔄</span> Small shifts that change a lot</h2>
        <div class="ed-shifts">
          {
            g.shifts.map((s) => (
              <div class="ed-shift">
                <div class="ed-shift__from"><strong>Instead of</strong><span set:html={mdInline(s.instead)} /></div>
                <span class="ed-shift__arrow" aria-hidden="true">→</span>
                <div class="ed-shift__to"><strong>Try</strong><span set:html={mdInline(s.tryThis)} /></div>
              </div>
            ))
          }
        </div>
      </section>

      <section>
        <h2 class="ed-heading"><span aria-hidden="true">🔁</span> Routines that fit any topic</h2>
        <div class="grid">
          {
            g.routines.map((r) => (
              <article class="card ed-card">
                <h3>{r.name} <small>{r.time}</small></h3>
                <div set:html={md(r.how)} />
              </article>
            ))
          }
        </div>
      </section>

      <section class="card ed-card">
        <h2><span aria-hidden="true">👀</span> See what they understand, without a test</h2>
        <ul>{g.assess.map((x) => <li set:html={mdInline(x)} />)}</ul>
      </section>

      <section>
        <h2 class="ed-heading"><span aria-hidden="true">📚</span> Notes for each topic</h2>
        <div class="grid">
          {
            topics.map((c) => (
              <a class="card concept-card" href={href(`${conceptPath(c)}educators/`)}>
                <span class="concept-card__body">
                  <span class="concept-card__title">{c.shortTitle}</span>
                  <span class="concept-card__sub">Hook, activities, questions</span>
                </span>
                <Icon name="arrow" size={18} />
              </a>
            ))
          }
        </div>
      </section>

      <section class="ed-note">
        <h2 class="ed-heading ed-heading--small">Where these ideas come from</h2>
        <ul class="muted">
          {g.sources.map((s) => <li><a href={s.url} rel="noopener">{s.label}</a></li>)}
        </ul>
      </section>
    </div>
  </div>
</Base>
