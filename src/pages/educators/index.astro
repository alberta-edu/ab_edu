---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { SUBJECTS, UNLOCK_AFTER } from '../../site.ts';
import { subjectGuide } from '../../lib/educator.ts';
import { THINKING_MOVES, MOVE_GROUPS } from '../../lib/thinking.ts';
import { levelBadge } from '../../lib/problem-html.ts';
import { href, absolute } from '../../lib/url.ts';

const description =
  'A guide for Alberta teachers and home-educating parents: how to use AB Edu to make learning fun, teach children to think, and adapt lessons for every child.';
const guides = SUBJECTS.filter((s) => subjectGuide(s.slug));
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'LearningResource',
    name: 'AB Edu guide for educators',
    description,
    url: absolute('educators/'),
    inLanguage: 'en-CA',
    isAccessibleForFree: true,
    learningResourceType: 'Teacher guide',
    audience: { '@type': 'EducationalAudience', educationalRole: 'teacher' },
  },
];
const thinking = ['Working out the real question', 'Breaking a hard problem down', 'Noticing what doesn’t fit', 'Deciding what to believe', 'Imagining something new'];
const stuck = [
  { say: 'What do you know for sure?', why: 'Starts from what they can do.' },
  { say: 'What is it really asking?', why: 'Most children are stuck on the question, not the math.' },
  { say: 'Can you draw it?', why: 'A picture shows what words hide.' },
  { say: 'What if the numbers were smaller?', why: 'The idea gets easier to see.' },
  { say: 'What have you tried?', why: 'A wrong try is information.' },
];
const everyChild = [
  {
    title: 'Getting interested and staying with it',
    icon: '💛',
    items: [
      'Start from what they love: a hockey card collection can carry almost any math idea.',
      'Give real choices: which problem, what order, draw or explain.',
      'Keep it short. Stop while it’s going well.',
    ],
  },
  {
    title: 'Taking in the ideas',
    icon: '👁️',
    items: ['Start with the animations, and replay them as often as needed.', 'Read problems aloud together, or use read-aloud.', 'Show an idea with real objects before symbols.'],
  },
  {
    title: 'Showing what they know',
    icon: '🎤',
    items: ['Let them say, draw, build or act it out. You can write for them.', 'Explaining out loud counts as much as writing.', 'Tick the self-check on written problems together.'],
  },
];
---
<Base title="For teachers and parents" description={description} path="educators/" jsonLd={jsonLd}>
  <div class="container ed">
    <header class="page-hero">
      <p class="page-hero__eyebrow">For educators</p>
      <h1>You teach. We help.</h1>
      <p class="page-hero__lede">Visuals, good problems and ideas for teachers and parents, including home educators. Not a replacement for you.</p>
    </header>

    <div class="ed-sections">
      <section class="card ed-card ed-card--hook">
        <h2><span aria-hidden="true">🧠</span> Why thinking comes first</h2>
        <p>Machines can now calculate and summarize faster than any of us. What stays valuable is the thinking:</p>
        <ul class="ed-chips">{thinking.map((t) => <li>{t}</li>)}</ul>
        <p>Facts still matter: they’re what we think <em>with</em>. So here, <strong>harder means more thinking, not bigger numbers.</strong></p>
      </section>

      <section>
        <h2 class="ed-heading"><span aria-hidden="true">🪜</span> How practice is built</h2>
        <div class="grid">
          <article class="card ed-card">
            <Fragment set:html={levelBadge(1)} />
            <p>One idea, one step. A quick win that shows the lesson landed.</p>
          </article>
          <article class="card ed-card">
            <Fragment set:html={levelBadge(2)} />
            <p>Read a story, table or map, then decide what to do. Solving {UNLOCK_AFTER} unlocks the next level.</p>
          </article>
          <article class="card ed-card">
            <Fragment set:html={levelBadge(3)} />
            <p>Investigate, design, find the flaw. Friendly numbers, real thinking. Struggle is the point.</p>
          </article>
        </div>
        <ul class="ed-checks">
          <li>Every problem traces to Alberta’s program of studies.</li>
          <li>Nothing needs knowledge above the grade.</li>
          <li>Every problem has hints, a worked solution and feedback on wrong answers.</li>
        </ul>
      </section>

      <section class="card ed-card">
        <h2><span aria-hidden="true">🛟</span> When a child is stuck, don’t rescue</h2>
        <p>Being stuck is where learning happens. Wait a little, then ask instead of explaining:</p>
        <dl class="ed-stuck">
          {
            stuck.map((s) => (
              <div>
                <dt>“{s.say}”</dt>
                <dd>{s.why}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section>
        <h2 class="ed-heading"><span aria-hidden="true">🗣️</span> The thinking skills children learn</h2>
        <p class="ed-note">After each correct answer, children see the skill they used. Use the same words at home: “You worked backwards there!”</p>
        <div class="ed-moves">
          {
            MOVE_GROUPS.map((g) => (
              <article class="ed-moves__group">
                <h3>{g.title}</h3>
                <ul>
                  {g.moves.map((m) => (
                    <li>
                      <span class="ed-moves__icon" aria-hidden="true">
                        {THINKING_MOVES[m].icon}
                      </span>
                      <span>
                        <strong>{THINKING_MOVES[m].name}</strong>
                        <span class="ed-moves__blurb">{THINKING_MOVES[m].blurb}</span>
                      </span>
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </section>

      <section id="subjects">
        <h2 class="ed-heading"><span aria-hidden="true">📚</span> Guides by subject</h2>
        <div class="grid">
          {
            guides.map((s) => (
              <a class="card concept-card" href={href(`grade-5/${s.slug}/educators/`)}>
                <span class="concept-card__body">
                  <span class="concept-card__title">{s.name}</span>
                  <span class="concept-card__sub">Routines, plus notes for every topic</span>
                </span>
                <Icon name="arrow" size={18} />
              </a>
            ))
          }
        </div>
        <p class="ed-note">Each topic also has its own notes: a hook, activities, questions to ask, common mix-ups and ways to adapt.</p>
      </section>

      <section id="every-child">
        <h2 class="ed-heading"><span aria-hidden="true">🌱</span> A guide for every child</h2>
        <p class="ed-note">
          Based on <a href="https://udlguidelines.cast.org/" rel="noopener">Universal Design for Learning</a>: build in choice from the start, so fewer
          children are exceptions.
        </p>
        <div class="grid">
          {
            everyChild.map((g) => (
              <article class="card ed-card">
                <h3>
                  <span aria-hidden="true">{g.icon}</span> {g.title}
                </h3>
                <ul>
                  {g.items.map((x) => (
                    <li>{x}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
        <div class="card ed-card ed-built-in">
          <h3>Already built into the site</h3>
          <ul>
            <li>Works with a keyboard and at 400% zoom. Screen-reader users haven’t tried it yet.</li>
            <li>Dark mode, an easy-to-read font, and reduced motion if your device asks.</li>
            <li>No timers, accounts or public scores. Wrong answers get an explanation, not a penalty.</li>
            <li>Hints and solutions are always there. Levels never fully lock.</li>
          </ul>
        </div>
        <p class="muted ed-note">Ideas to try, not medical or professional advice. A child’s own team knows them best.</p>
      </section>

      <section class="card ed-card" id="home">
        <h2><span aria-hidden="true">🏡</span> Home education in Alberta</h2>
        <ul>
          <li>
            Parents can direct a home education program for Grades 1 to 12, in one of two ways:
            <ul>
              <li><strong>Supervised</strong> by a school authority: funding, and two evaluations a year.</li>
              <li><strong>Notification only</strong>: no funding.</li>
            </ul>
          </li>
          <li>The Association of Independent Schools and Colleges of Alberta helps families find resources, workshops and assessments.</li>
          <li>For the current rules, see <a href="https://www.alberta.ca/home-education" rel="noopener">Alberta’s home education page</a>.</li>
          <li>This site can support a program. It isn’t a full program, and it isn’t endorsed by Alberta Education.</li>
        </ul>
      </section>

      <section class="ed-note">
        <h2 class="ed-heading ed-heading--small">Where these ideas come from</h2>
        <ul class="muted">
          <li><a href="https://udlguidelines.cast.org/" rel="noopener">CAST: Universal Design for Learning Guidelines 3.0</a></li>
          <li><a href="https://open.alberta.ca/publications/9780778586012" rel="noopener">Alberta Education: Making a Difference, on differentiated instruction</a></li>
          <li><a href="https://www.alberta.ca/inclusive-education" rel="noopener">Government of Alberta: inclusive education</a></li>
          <li><a href="https://nrich.maths.org/7701" rel="noopener">NRICH: using low-threshold, high-ceiling tasks</a></li>
          <li><a href="https://www.buildingthinkingclassrooms.com/about-btc" rel="noopener">Peter Liljedahl: Building Thinking Classrooms</a></li>
        </ul>
      </section>
    </div>
  </div>
</Base>
