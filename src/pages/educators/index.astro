---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { SUBJECTS, UNLOCK_AFTER } from '../../site.ts';
import { subjectGuide } from '../../lib/educator.ts';
import { THINKING_MOVES, MOVE_GROUPS } from '../../lib/thinking.ts';
import { levelBadge } from '../../lib/problem-html.ts';
import { href, absolute } from '../../lib/url.ts';

const description =
  'A guide for Alberta teachers and home-educating parents: how to use AB Edu to make learning fun, teach children to think, and adapt lessons for every child.';
const guides = SUBJECTS.filter((s) => subjectGuide(s.slug));
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'LearningResource',
    name: 'AB Edu guide for educators',
    description,
    url: absolute('educators/'),
    inLanguage: 'en-CA',
    isAccessibleForFree: true,
    learningResourceType: 'Teacher guide',
    audience: { '@type': 'EducationalAudience', educationalRole: 'teacher' },
  },
];
const thinking = ['Find the real question', 'Break it down', 'Spot what doesn’t fit', 'Decide what to believe', 'Imagine something new'];
const stuck = [
  { say: 'What do you know for sure?', why: 'Start from what they can do.' },
  { say: 'What is it really asking?', why: 'Often the question is the hard part.' },
  { say: 'Can you draw it?', why: 'A picture shows what words hide.' },
  { say: 'Can you try an easier one?', why: 'The idea gets easier to see.' },
  { say: 'What have you tried?', why: 'A wrong try is information.' },
];
const everyChild = [
  { title: 'Staying interested', icon: '💛', items: ['Start from what they love.', 'Let them choose what and how.', 'Stop while it’s going well.'] },
  { title: 'Taking ideas in', icon: '👁️', items: ['Replay the animations often.', 'Read aloud together.', 'Show it with real objects first.'] },
  { title: 'Showing learning', icon: '🎤', items: ['Let them say, draw or build it.', 'Talking counts as writing.', 'You can write for them.'] },
];
---
<Base title="For teachers and parents" description={description} path="educators/" jsonLd={jsonLd}>
  <div class="container ed">
    <header class="page-hero">
      <p class="page-hero__eyebrow">For educators</p>
      <h1>You teach. We help.</h1>
      <p class="page-hero__lede">Visuals, good problems and ideas for teachers and parents, including home educators. Not a replacement for you.</p>
    </header>

    <div class="ed-sections">
      <section class="card ed-card ed-card--hook">
        <h2><span aria-hidden="true">🧠</span> Thinking comes first</h2>
        <p>Machines calculate and summarize faster than we do. The thinking is what stays valuable:</p>
        <ul class="ed-chips">{thinking.map((t) => <li>{t}</li>)}</ul>
        <p>Facts still matter. They’re what we think <em>with</em>.</p>
      </section>

      <section>
        <h2 class="ed-heading"><span aria-hidden="true">🪜</span> How practice is built</h2>
        <div class="grid">
          <article class="card ed-card">
            <Fragment set:html={levelBadge(1)} />
            <p>One idea, one step. A quick win that shows the lesson landed.</p>
          </article>
          <article class="card ed-card">
            <Fragment set:html={levelBadge(2)} />
            <p>Read a story, table or map, then decide what to do. Solving {UNLOCK_AFTER} unlocks the next level.</p>
          </article>
          <article class="card ed-card">
            <Fragment set:html={levelBadge(3)} />
            <p>Investigate, design, find the flaw. Struggle is the point.</p>
          </article>
        </div>
        <ul class="ed-checks">
          <li>Every problem traces to Alberta’s program of studies.</li>
          <li>Nothing needs knowledge above the grade.</li>
          <li>Every problem has hints, a worked solution and feedback on wrong answers.</li>
        </ul>
      </section>

      <section class="card ed-card">
        <h2><span aria-hidden="true">🛟</span> When a child is stuck, don’t rescue</h2>
        <p>Being stuck is where learning happens. Wait a little, then ask instead of explaining:</p>
        <dl class="ed-stuck">
          {
            stuck.map((s) => (
              <div>
                <dt>“{s.say}”</dt>
                <dd>{s.why}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section>
        <h2 class="ed-heading"><span aria-hidden="true">🗣️</span> The thinking skills children learn</h2>
        <p class="ed-note">After each correct answer, children see the skill they used. Use the same words: “You worked backwards there!”</p>
        <div class="ed-moves">
          {
            MOVE_GROUPS.map((g) => (
              <article class="ed-moves__group">
                <h3>{g.title}</h3>
                <ul>
                  {g.moves.map((m) => (
                    <li>
                      <span class="ed-moves__icon" aria-hidden="true">
                        {THINKING_MOVES[m].icon}
                      </span>
                      <span>
                        <strong>{THINKING_MOVES[m].name}</strong>
                        <span class="ed-moves__blurb">{THINKING_MOVES[m].blurb}</span>
                      </span>
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </section>

      <section id="subjects">
        <h2 class="ed-heading"><span aria-hidden="true">📚</span> Guides by subject</h2>
        <p class="ed-note">Class routines for each subject, and notes for every topic: a hook, activities, questions and ways to adapt.</p>
        <div class="grid grid--2">
          {
            guides.map((s) => (
              <a class="card concept-card" href={href(`grade-5/${s.slug}/educators/`)}>
                <span class="ed-subject-icon" aria-hidden="true">
                  <Icon name={s.icon as 'book'} size={20} />
                </span>
                <span class="concept-card__body concept-card__title">{s.name}</span>
                <Icon name="arrow" size={18} />
              </a>
            ))
          }
        </div>
      </section>

      <section id="every-child">
        <h2 class="ed-heading"><span aria-hidden="true">🌱</span> A guide for every child</h2>
        <p class="ed-note">
          Based on <a href="https://udlguidelines.cast.org/" rel="noopener">Universal Design for Learning</a>: build in choice from the start.
        </p>
        <div class="grid grid--3">
          {
            everyChild.map((g) => (
              <article class="card ed-card">
                <h3>
                  <span aria-hidden="true">{g.icon}</span> {g.title}
                </h3>
                <ul>
                  {g.items.map((x) => (
                    <li>{x}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
        <p class="muted ed-note">Ideas to try, not professional advice. A child’s own team knows them best.</p>
      </section>

      <section class="card ed-card" id="home">
        <h2><span aria-hidden="true">🏡</span> Home education in Alberta</h2>
        <p>Parents can lead a program for Grades 1 to 12 in two ways:</p>
        <ul>
          <li><strong>Supervised</strong> by a school authority: funding, two evaluations a year.</li>
          <li><strong>Notification only</strong>: no funding.</li>
        </ul>
        <p>Current rules: <a href="https://www.alberta.ca/home-education" rel="noopener">Alberta’s home education page</a>.</p>
        <p class="muted ed-note">This site supports a program. It isn’t a full program, or endorsed by Alberta Education.</p>
      </section>

      <section class="ed-note">
        <h2 class="ed-heading ed-heading--small">Where these ideas come from</h2>
        <ul class="muted">
          <li><a href="https://udlguidelines.cast.org/" rel="noopener">CAST: Universal Design for Learning Guidelines 3.0</a></li>
          <li><a href="https://open.alberta.ca/publications/9780778586012" rel="noopener">Alberta Education: Making a Difference, on differentiated instruction</a></li>
          <li><a href="https://www.alberta.ca/inclusive-education" rel="noopener">Government of Alberta: inclusive education</a></li>
          <li><a href="https://nrich.maths.org/7701" rel="noopener">NRICH: using low-threshold, high-ceiling tasks</a></li>
          <li><a href="https://www.buildingthinkingclassrooms.com/about-btc" rel="noopener">Peter Liljedahl: Building Thinking Classrooms</a></li>
        </ul>
      </section>
    </div>
  </div>
</Base>
