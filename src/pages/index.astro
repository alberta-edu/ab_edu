---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { GRADES, SITE_NAME, gradeName } from '../site.ts';
import { href, absolute } from '../lib/url.ts';
import { levelBadge } from '../lib/problem-html.ts';
import { gradesWithContent, gradePath } from '../lib/content.ts';

const ready = new Set(gradesWithContent());
const description =
  'Free lessons, interactive visuals and practice problems that follow the Alberta Grade 1 to 6 curriculum: ELA, Math, Science and Social Studies.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: absolute(''),
    description,
    inLanguage: 'en-CA',
  },
];
---
<Base title={SITE_NAME} description={description} path="" jsonLd={jsonLd}>
  <section class="home-hero">
    <div class="container home-hero__grid">
      <div>
      <p class="page-hero__eyebrow">Alberta Grades 1–6 · Free · No sign-up</p>
      <h1>See it. Try it. <span class="home-hero__accent">Remember it.</span></h1>
      <p class="page-hero__lede">
        Short visual lessons, animated experiments, and practice that grows from easy to tricky, all matched to what
        Alberta students learn in class.
      </p>
      <div class="control-row">
        <a class="btn btn--primary" href="#grades">Choose your grade <Icon name="arrow" size={18} /></a>
        <a class="btn btn--ghost" href={href('review/')}><Icon name="review" size={18} /> Today's review</a>
      </div>
      </div>
      <svg class="home-art" viewBox="0 0 420 340" aria-hidden="true">
        <g class="art-card" transform="translate(20 24) rotate(-4)">
          <rect width="220" height="128" rx="16"></rect>
          <text x="18" y="34" class="art-label">Fractions</text>
          {[0, 1, 2, 3].map((i) => <rect x={18 + i * 46} y="52" width="44" height="30" rx="4" class={i < 3 ? 'art-on' : 'art-off'}></rect>)}
          <line x1="18" y1="106" x2="202" y2="106" class="art-axis"></line>
          <circle cx="156" cy="106" r="7" class="art-sun"></circle>
        </g>
        <g class="art-card" transform="translate(200 70) rotate(5)">
          <rect width="190" height="150" rx="16"></rect>
          <text x="18" y="34" class="art-label art-label--sci">Particles</text>
          {[[40, 70], [80, 95], [125, 62], [150, 110], [60, 120], [110, 128], [30, 100], [140, 80]].map(([x, y]) => <circle cx={x} cy={y} r="9" class="art-dot"></circle>)}
        </g>
        <g class="art-card" transform="translate(50 180) rotate(-2)">
          <rect width="230" height="130" rx="16"></rect>
          <text x="18" y="34" class="art-label art-label--soc">Latitude &amp; longitude</text>
          {[0, 1, 2, 3, 4].map((i) => <line x1={18 + i * 48} y1="48" x2={18 + i * 48} y2="112" class="art-grid"></line>)}
          {[0, 1, 2].map((i) => <line x1="18" y1={48 + i * 32} x2="210" y2={48 + i * 32} class={i === 1 ? 'art-eq' : 'art-grid'}></line>)}
          <circle cx="130" cy="66" r="7" class="art-sun"></circle>
        </g>
        <g transform="translate(262 262)">
          <rect width="132" height="34" rx="17" class="art-badge"></rect>
          <text x="66" y="22" text-anchor="middle" class="art-badge-text">★★★ Deep Think</text>
        </g>
      </svg>
    </div>
  </section>

  <div class="container">
    <section class="home-section" aria-labelledby="grades">
      <h2 id="grades">Choose a grade</h2>
      <div class="grade-row">
        {
          GRADES.map((g) =>
            ready.has(g) ? (
              <a class="grade-pill grade-pill--on" href={href(gradePath(g))}>
                <span class="grade-pill__num">{g}</span>
                {gradeName(g)}
              </a>
            ) : (
              <span class="grade-pill" aria-disabled="true">
                <span class="grade-pill__num">{g}</span>
                {gradeName(g)}
                <small>Coming later</small>
              </span>
            ),
          )
        }
      </div>
    </section>

    <section class="home-section" aria-labelledby="how">
      <h2 id="how">How it works</h2>
      <div class="grid grid--4 how-grid">
        <div class="card how">
          <span class="how__icon"><Icon name="spark" /></span>
          <h3>See the idea first</h3>
          <p>Every topic opens with a visual you can play with: fraction bars, a particle simulator, a world map, and animated experiments.</p>
        </div>
        <div class="card how">
          <span class="how__icon"><Icon name="chart" /></span>
          <h3>Three levels of practice</h3>
          <p>
            <Fragment set:html={levelBadge(1)} />
            <Fragment set:html={levelBadge(2)} />
            <Fragment set:html={levelBadge(3)} />
          </p>
          <p>Start easy, unlock harder problems, with hints and worked solutions all the way.</p>
        </div>
        <div class="card how">
          <span class="how__icon"><Icon name="review" /></span>
          <h3>Review at the right time</h3>
          <p>Topics come back after 1, 3, 7, 14, 30 and 60 days, just before you would forget them.</p>
        </div>
        <div class="card how">
          <span class="how__icon"><Icon name="lock" /></span>
          <h3>Private by design</h3>
          <p>No accounts and no tracking. Your progress is saved only in this browser. You can export a backup any time.</p>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .home-hero { padding-block: clamp(2.5rem, 7vw, 5rem); background: radial-gradient(60rem 22rem at 85% 0%, var(--brand-soft), transparent), radial-gradient(40rem 20rem at 0% 100%, color-mix(in srgb, var(--sun) 18%, transparent), transparent); border-bottom: 1px solid var(--line); }
  .home-hero__grid { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 56rem) { .home-hero__grid { grid-template-columns: 1.15fr 1fr; } }
  .home-art { width: 100%; max-width: 30rem; justify-self: center; }
  @media (max-width: 55.99rem) { .home-art { display: none; } }
  .art-card > rect:first-child { fill: var(--surface); stroke: var(--line); filter: drop-shadow(0 6px 14px rgb(20 18 30 / 12%)); }
  .art-label { font: 700 15px var(--font); fill: var(--math); }
  .art-label--sci { fill: var(--science); }
  .art-label--soc { fill: var(--social); }
  .art-on { fill: var(--math); }
  .art-off { fill: var(--surface-3); }
  .art-axis { stroke: var(--ink-2); stroke-width: 3; }
  .art-sun { fill: var(--sun); stroke: var(--ink); stroke-width: 2; }
  .art-dot { fill: var(--science); opacity: 0.85; }
  .art-grid { stroke: var(--ink-3); stroke-opacity: 0.4; }
  .art-eq { stroke: var(--bad); stroke-width: 2.5; }
  .art-badge { fill: var(--l3-soft); }
  .art-badge-text { font: 700 14px var(--font); fill: var(--l3); }
  @media (prefers-reduced-motion: no-preference) {
    .art-dot { animation: jiggle 1.6s ease-in-out infinite alternate; }
    .art-dot:nth-of-type(2n) { animation-duration: 1.1s; }
    @keyframes jiggle { to { transform: translate(3px, -4px); } }
  }
  .home-hero h1 { font-size: clamp(2.1rem, 1.5rem + 3vw, 3.6rem); max-width: 16ch; }
  .home-hero__accent { color: var(--brand); }
  .home-section { margin-block: 2.75rem; }
  .grade-row { display: grid; gap: 0.6rem; grid-template-columns: repeat(3, 1fr); }
  @media (min-width: 48rem) { .grade-row { grid-template-columns: repeat(6, 1fr); } }
  .grade-pill { display: flex; flex-direction: column; align-items: center; gap: 0.35rem; padding: 0.9rem 0.5rem; border-radius: 18px; border: 1px solid var(--line); background: var(--surface); color: var(--ink-3); font-weight: 700; text-decoration: none; text-align: center; }
  .grade-pill small { font-weight: 400; font-size: 0.75rem; }
  .grade-pill__num { width: 2.6rem; height: 2.6rem; border-radius: 50%; display: grid; place-items: center; background: var(--surface-2); font-size: var(--step-1); }
  .grade-pill--on { color: var(--ink); border-color: var(--brand); box-shadow: var(--shadow); }
  .grade-pill--on .grade-pill__num { background: var(--brand); color: var(--brand-ink); }
  .how { padding: 1.25rem; }
  .how p { color: var(--ink-2); margin-bottom: 0.6rem; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .how__icon { display: inline-grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 12px; background: var(--brand-soft); color: var(--brand); margin-bottom: 0.6rem; }
</style>
