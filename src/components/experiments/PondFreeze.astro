---
// Animated experiment: a pond through a cold week. The air drops below 0 °C, and ice forms on the
// surface and thickens downward. Ice is less dense than liquid water, so it stays on top as a
// sheet, and the fish keep swimming in the liquid water below (SCI6-OI1-GQ1-LO1, K3.3-K3.6, S3.2).
---
<g6-pond-freeze>
  <svg class="sci-svg" viewBox="0 0 640 320" aria-hidden="true" data-pf="svg"></svg>
  <p class="sr-only" aria-live="polite" data-pf="live"></p>
</g6-pond-freeze>

<style is:global>
  g6-pond-freeze { display: block; }
  g6-pond-freeze svg { background: var(--surface-2); }
  .g6s-pf-ground { fill: color-mix(in srgb, #8b5a2b 40%, var(--surface)); }
  .g6s-pf-snow { fill: #f4f8ff; stroke: #c9d6e8; stroke-width: 1.5; }
  .g6s-pf-ice { fill: #dff1ff; stroke: #6aa9d8; stroke-width: 2; }
  .g6s-pf-fish { fill: #e5793a; stroke: var(--ink); stroke-width: 1.5; }
  .g6s-pf-reed { stroke: #3f9a40; stroke-width: 4; stroke-linecap: round; }
</style>

<script>
  import { tween, wait } from './anim.ts';

  const SURF = 120; // water surface
  const LEFT = 60;
  const RIGHT = 580;
  const BOTTOM = 290;
  const MAX_ICE = 34;

  class PondFreeze extends HTMLElement {
    private day = 0;
    private air = 5;
    private ice = 0;
    private t = 0;
    private snow = 0;

    connectedCallback() {
      this.draw();
    }

    async run() {
      const live = this.querySelector('[data-pf="live"]')!;
      live.textContent = '';
      await tween(7000, (t) => {
        this.t = t * 60;
        this.day = Math.min(7, 1 + Math.floor(t * 7));
        this.air = Math.round(5 - 20 * Math.min(1, t / 0.3));
        this.ice = MAX_ICE * Math.max(0, Math.min(1, (t - 0.2) / 0.75)) ** 0.7;
        this.snow = Math.max(0, (t - 0.5) * 2);
        this.draw();
      });
      await wait(150);
      live.textContent = 'The air dropped to minus 15 degrees. Ice formed on the surface of the pond and grew thicker downward. Liquid water stayed below the ice, and the fish kept swimming.';
    }

    private fish(x: number, y: number, dir: number) {
      const s = dir;
      return `<g transform="translate(${x.toFixed(1)} ${y.toFixed(1)}) scale(${s} 1)"><ellipse class="g6s-pf-fish" cx="0" cy="0" rx="20" ry="9"/><path class="g6s-pf-fish" d="M-18 0 L-32 -9 L-32 9 Z"/><circle cx="10" cy="-2" r="2" fill="#1c1b24"/></g>`;
    }

    private draw() {
      const pond = `M${LEFT} ${SURF} Q${LEFT + 20} ${BOTTOM} 320 ${BOTTOM} Q${RIGHT - 20} ${BOTTOM} ${RIGHT} ${SURF} Z`;
      const fx = (k: number, ph: number) => 320 + Math.sin(this.t * 0.25 * k + ph) * 150;
      const dirOf = (k: number, ph: number) => (Math.cos(this.t * 0.25 * k + ph) >= 0 ? 1 : -1);
      const out = [
        `<rect class="g6s-pf-ground" x="0" y="${SURF}" width="640" height="200"/>`,
        `<clipPath id="g6s-pf-clip"><path d="${pond}"/></clipPath>`,
        `<path class="sci-water" d="${pond}"/>`,
        `<g clip-path="url(#g6s-pf-clip)">`,
        this.fish(fx(1, 0), 200, dirOf(1, 0)),
        this.fish(fx(0.7, 2), 245, dirOf(0.7, 2)),
        this.ice > 0.5 ? `<rect class="g6s-pf-ice" x="0" y="${SURF}" width="640" height="${this.ice.toFixed(1)}"/>` : '',
        `</g>`,
        this.snow > 0 ? `<rect class="g6s-pf-snow" x="0" y="${SURF - 8 * this.snow}" width="${LEFT + 4}" height="${8 * this.snow}"/><rect class="g6s-pf-snow" x="${RIGHT - 4}" y="${SURF - 8 * this.snow}" width="${644 - RIGHT}" height="${8 * this.snow}"/>` : '',
        `<line class="g6s-pf-reed" x1="30" y1="${SURF}" x2="26" y2="${SURF - 46}"/><line class="g6s-pf-reed" x1="42" y1="${SURF}" x2="46" y2="${SURF - 38}"/>`,
        `<text class="sci-text" x="20" y="34">Air: ${String(this.air).replace('-', '−')} °C</text>`,
        `<text class="sci-text" x="620" y="34" text-anchor="end">${this.day ? `Day ${this.day} of 7` : 'Day 0'}</text>`,
      ];
      if (this.ice > 6) {
        out.push(`<text class="sci-small" x="320" y="${SURF + Math.min(this.ice, MAX_ICE) / 2 + 5}" text-anchor="middle">ice</text>`);
      }
      if (this.day === 7 && this.ice > MAX_ICE - 1) out.push(`<text class="sci-small" x="320" y="${SURF + 70}" text-anchor="middle">liquid water</text>`);
      this.querySelector('[data-pf="svg"]')!.innerHTML = out.join('');
    }
  }
  customElements.define('g6-pond-freeze', PondFreeze);
</script>
