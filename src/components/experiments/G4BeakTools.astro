---
// Animated experiment: a hummingbird (long, thin beak) and an evening grosbeak (short, thick beak)
// each try two foods: nectar deep in a long flower, and a hard sunflower seed. Each beak works for
// one food only (SCI4-OI4-GQ1-LO1, K1.3, K1.4, K1.5, S1.4).
---
<g4-beak-tools>
  <svg class="sci-svg" viewBox="0 0 660 300" aria-hidden="true" data-g4s="svg"></svg>
  <p class="sr-only" aria-live="polite" data-g4s="live"></p>
</g4-beak-tools>

<style is:global>
  g4-beak-tools { display: block; }
  g4-beak-tools svg { background: var(--surface-2); }
  .g4s-bt-hum { fill: #3f9a6a; stroke: var(--ink-2); stroke-width: 1.5; }
  .g4s-bt-gro { fill: #e0b52e; stroke: var(--ink-2); stroke-width: 1.5; }
  .g4s-bt-wing { fill: #2d2d33; }
  .g4s-bt-beak { fill: #3a3a3a; }
  .g4s-bt-beak2 { fill: #d8d2a8; stroke: #6b6440; stroke-width: 1.5; }
  .g4s-bt-eye { fill: #111; }
  .g4s-bt-flower { fill: #e0533d; stroke: #8a2a1c; stroke-width: 1.5; }
  .g4s-bt-nectar { fill: #ffe27a; }
  .g4s-bt-seed { fill: #3a3a3a; stroke: #d8d2a8; stroke-width: 2; }
  .g4s-bt-name { fill: var(--ink); font-size: 16px; font-weight: 700; }
  .g4s-bt-ok { fill: var(--ok); font-size: 22px; font-weight: 700; }
  .g4s-bt-no { fill: var(--bad); font-size: 22px; font-weight: 700; }
</style>

<script>
  import { tween, wait } from './anim.ts';

  const ROWS = [
    { id: 'hum', y: 90, name: 'Hummingbird', nectar: true, seed: false },
    { id: 'gro', y: 220, name: 'Grosbeak', nectar: false, seed: true },
  ];
  const FLOWER_X = 300;
  const SEED_X = 480;

  class G4BeakTools extends HTMLElement {
    private pos = [0, 0]; // 0 at the perch, 1 at the flower, 2 at the seed
    private poke = [0, 0];
    private nectar = [1, 1];
    private cracked = [false, false];
    private marks: string[][] = [[], []];

    connectedCallback() {
      this.draw();
    }

    async run() {
      this.pos = [0, 0];
      this.poke = [0, 0];
      this.nectar = [1, 1];
      this.cracked = [false, false];
      this.marks = [[], []];
      this.querySelector('[data-g4s="live"]')!.textContent = '';
      for (const food of ['nectar', 'seed'] as const) {
        const target = food === 'nectar' ? 1 : 2;
        const from = [...this.pos];
        await tween(700, (t) => ((this.pos = from.map((f) => f + (target - f) * t)), this.draw()));
        await tween(1100, (t) => {
          const p = Math.sin(t * Math.PI * 3) ** 2;
          this.poke = [p, p];
          ROWS.forEach((r, i) => {
            if (food === 'nectar' && r.nectar) this.nectar[i] = 1 - t;
            if (food === 'seed' && r.seed && t > 0.5) this.cracked[i] = true;
          });
          this.draw();
        });
        this.poke = [0, 0];
        ROWS.forEach((r, i) => this.marks[i].push(r[food] ? 'ok' : 'no'));
        this.draw();
        await wait(350);
      }
      this.querySelector('[data-g4s="live"]')!.textContent =
        'The hummingbird’s long, thin beak reached the nectar deep in the flower, but it could not crack the seed. The grosbeak’s short, thick beak could not reach the nectar, but it cracked the seed open.';
    }

    private bird(r: (typeof ROWS)[number], x: number, poke: number) {
      const y = r.y;
      if (r.id === 'hum') {
        const reach = 54 + 48 * poke;
        return `<ellipse class="g4s-bt-hum" cx="${x - 26}" cy="${y + 8}" rx="22" ry="11"/><circle class="g4s-bt-hum" cx="${x - 2}" cy="${y}" r="10"/><path class="g4s-bt-wing" d="M${x - 30},${y + 2} l-6,-22 l18,16 Z"/><circle class="g4s-bt-eye" cx="${x + 2}" cy="${y - 2}" r="2"/><path class="g4s-bt-beak" d="M${x + 7},${y - 1} L${x + 7 + reach},${y + 2} L${x + 7},${y + 3} Z"/>`;
      }
      const reach = 18 + 6 * poke;
      return `<ellipse class="g4s-bt-gro" cx="${x - 28}" cy="${y + 10}" rx="26" ry="15"/><circle class="g4s-bt-gro" cx="${x - 2}" cy="${y}" r="14"/><path class="g4s-bt-wing" d="M${x - 40},${y + 4} l30,-4 l-6,14 Z"/><circle class="g4s-bt-eye" cx="${x + 2}" cy="${y - 4}" r="2.2"/><path class="g4s-bt-beak2" d="M${x + 9},${y - 9} L${x + 9 + reach},${y + 1} L${x + 9},${y + 9} Z"/>`;
    }

    private draw() {
      const out: string[] = [];
      ROWS.forEach((r, i) => {
        // A long tube flower with nectar at the bottom, opening toward the bird.
        const fy = r.y;
        out.push(`<path class="g4s-bt-flower" d="M${FLOWER_X},${fy - 12} L${FLOWER_X + 60},${fy - 6} L${FLOWER_X + 60},${fy + 8} L${FLOWER_X},${fy + 14} Z"/>`);
        out.push(`<rect class="g4s-bt-nectar" x="${FLOWER_X + 42}" y="${fy - 3}" width="${(14 * this.nectar[i]).toFixed(1)}" height="8"/>`);
        // A sunflower seed, whole or cracked open.
        out.push(this.cracked[i] ? `<path class="g4s-bt-seed" d="M${SEED_X + 40},${fy + 2} l14,-10 l4,6 Z"/><path class="g4s-bt-seed" d="M${SEED_X + 40},${fy + 6} l14,10 l4,-6 Z"/>` : `<ellipse class="g4s-bt-seed" cx="${SEED_X + 48}" cy="${fy + 4}" rx="14" ry="7"/>`);
        // The bird flies from its perch to each food. Its beak tip stops at the food’s opening.
        const stops = [80, FLOWER_X - 62 + (r.id === 'hum' ? 0 : 40), SEED_X + (r.id === 'hum' ? -27 : 7)];
        const p = this.pos[i];
        const x = p <= 1 ? stops[0] + (stops[1] - stops[0]) * p : stops[1] + (stops[2] - stops[1]) * (p - 1);
        out.push(this.bird(r, x, this.poke[i]));
        out.push(`<text class="g4s-bt-name" x="16" y="${r.y + 46}">${r.name}</text>`);
        this.marks[i].forEach((m, k) => out.push(`<text class="${m === 'ok' ? 'g4s-bt-ok' : 'g4s-bt-no'}" x="${k === 0 ? FLOWER_X + 30 : SEED_X + 48}" y="${r.y - 26}" text-anchor="middle">${m === 'ok' ? '✓' : '✗'}</text>`));
      });
      out.push(`<text class="sci-small" x="${FLOWER_X + 30}" y="22" text-anchor="middle">Nectar in a long flower</text><text class="sci-small" x="${SEED_X + 48}" y="22" text-anchor="middle">Sunflower seed</text>`);
      out.push('<line x1="0" y1="155" x2="660" y2="155" style="stroke:var(--line-strong);stroke-width:2;stroke-dasharray:6 6"/>');
      this.querySelector('[data-g4s="svg"]')!.innerHTML = out.join('');
    }
  }
  customElements.define('g4-beak-tools', G4BeakTools);
</script>
