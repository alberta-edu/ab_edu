---
// Animated experiment: testing an old explanation, "the eyes are a source of light". A person sits
// in a sealed room with a ball. With the lamp off, nothing reaches the eyes and the ball can't be
// seen. With the lamp on, light travels from the lamp, bounces off the ball and enters the eyes
// (SCI6-OI7-GQ1-LO1, K4.3, U4.1, S4.2, K2.1).
---
<g6-dark-room>
  <svg class="sci-svg" viewBox="0 0 640 300" aria-hidden="true" data-dr="svg"></svg>
  <p class="sr-only" aria-live="polite" data-dr="live"></p>
</g6-dark-room>

<style is:global>
  g6-dark-room { display: block; }
  g6-dark-room svg { background: var(--surface-2); }
  .g6s-dr-room { fill: #10131c; }
  .g6s-dr-lit { fill: #f6efd8; }
  .g6s-dr-head { fill: #e0b48a; stroke: #1c1b24; stroke-width: 2; }
  .g6s-dr-eye { fill: #1c1b24; }
  .g6s-dr-ball { fill: #e5484d; stroke: #1c1b24; stroke-width: 2; }
  .g6s-dr-lamp { fill: #6d7684; }
  .g6s-dr-bulb { fill: #ffd84d; }
  .g6s-dr-ray { stroke: #f2b01e; stroke-width: 4; stroke-linecap: round; }
  .g6s-dr-text { font-size: 15px; font-weight: 700; }
  .g6s-dr-thought { fill: var(--surface); stroke: var(--ink-2); stroke-width: 2; }
  @media (max-width: 40rem) { .g6s-dr-text { font-size: 22px; } }
</style>

<script>
  import { tween, wait } from './anim.ts';

  const EYE = [130, 150];
  const BALL = [470, 200];
  const LAMP = [470, 50];

  class DarkRoom extends HTMLElement {
    private lampOn = false;
    private ray = 0; // 0 to 2: lamp to ball, then ball to eye
    private phase: 'start' | 'dark' | 'light' = 'start';

    connectedCallback() {
      this.draw();
    }

    async run() {
      const live = this.querySelector('[data-dr="live"]')!;
      live.textContent = '';
      this.lampOn = false; this.ray = 0; this.phase = 'dark';
      this.draw();
      await wait(2200);
      this.lampOn = true;
      this.phase = 'light';
      await tween(2400, (t) => { this.ray = t * 2; this.draw(); });
      await wait(150);
      live.textContent = 'With the lamp off, the person could not see the ball. With the lamp on, light travelled from the lamp to the ball and bounced into the person’s eyes, and the person could see the ball.';
    }

    private draw() {
      const on = this.lampOn;
      const out: string[] = [`<rect class="${on ? 'g6s-dr-lit' : 'g6s-dr-room'}" x="20" y="20" width="600" height="250" rx="8"/>`];
      out.push(`<rect class="g6s-dr-lamp" x="${LAMP[0] - 20}" y="22" width="40" height="18"/><circle class="${on ? 'g6s-dr-bulb' : 'g6s-dr-lamp'}" cx="${LAMP[0]}" cy="${LAMP[1]}" r="12"/>`);
      out.push(`<circle class="g6s-dr-ball" cx="${BALL[0]}" cy="${BALL[1]}" r="26" opacity="${this.phase === 'dark' ? 0.08 : 1}"/>`);
      out.push(`<circle class="g6s-dr-head" cx="${EYE[0] - 20}" cy="${EYE[1]}" r="30"/><circle class="g6s-dr-eye" cx="${EYE[0]}" cy="${EYE[1] - 6}" r="4"/>`);
      if (on) {
        const seg1 = Math.min(1, this.ray);
        const seg2 = Math.max(0, this.ray - 1);
        const x1 = LAMP[0];
        const y1 = LAMP[1] + 12;
        out.push(`<line class="g6s-dr-ray" x1="${x1}" y1="${y1}" x2="${x1}" y2="${(y1 + (BALL[1] - 26 - y1) * seg1).toFixed(1)}"/>`);
        if (seg2 > 0) {
          const sx = BALL[0] - 24;
          const sy = BALL[1] - 8;
          out.push(`<line class="g6s-dr-ray" x1="${sx}" y1="${sy}" x2="${(sx + (EYE[0] + 6 - sx) * seg2).toFixed(1)}" y2="${(sy + (EYE[1] - 6 - sy) * seg2).toFixed(1)}"/>`);
        }
      }
      // What the person sees.
      const sees = this.phase === 'start' ? '' : this.phase === 'dark' ? 'I see nothing at all.' : this.ray >= 2 ? 'I see a red ball!' : '…';
      if (sees) out.push(`<rect class="g6s-dr-thought" x="40" y="200" width="260" height="50" rx="20"/><text class="g6s-dr-text" x="170" y="232" text-anchor="middle" fill="var(--ink)">${sees}</text>`);
      out.push(`<text class="g6s-dr-text" x="600" y="${on ? 260 : 260}" text-anchor="end" fill="${on ? 'var(--ink)' : '#dfe7ff'}">${this.phase === 'start' ? 'Sealed room' : on ? 'Lamp on' : 'Lamp off'}</text>`);
      this.querySelector('[data-dr="svg"]')!.innerHTML = out.join('');
    }
  }
  customElements.define('g6-dark-room', DarkRoom);
</script>
