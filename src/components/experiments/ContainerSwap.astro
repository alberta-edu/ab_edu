---
// Animated experiment: a solid, a liquid and a gas each start in a tall, narrow container.
// The containers change into wide, short ones. The particle model shows why the solid
// keeps its shape, the liquid flows to cover the bottom, and the gas fills every space.
interface Props {
  seconds?: number;
}
const { seconds = 6 } = Astro.props;
---
<container-swap data-seconds={seconds}>
  <canvas width="660" height="300" aria-hidden="true"></canvas>
  <p class="sr-only" aria-live="polite" data-cs="live"></p>
</container-swap>

<style is:global>
  container-swap { display: block; }
  container-swap canvas { display: block; width: 100%; height: auto; border-radius: var(--radius-sm); background: var(--surface-2); }
</style>

<script>
  type Kind = 'solid' | 'liquid' | 'gas';
  interface P { x: number; y: number; vx: number; vy: number; hx: number; hy: number }
  interface Lane { kind: Kind; cx: number; ps: P[] }

  const W = 660;
  const H = 300;
  const R = 7;
  const FLOOR = 250; // inside floor of every container
  const NARROW = { w: 70, h: 180 };
  const WIDE = { w: 190, h: 110 };
  const LABELS: Record<Kind, string> = { solid: 'Solid', liquid: 'Liquid', gas: 'Gas' };

  class ContainerSwap extends HTMLElement {
    private ctx!: CanvasRenderingContext2D;
    private lanes: Lane[] = [];
    private t = 0; // seconds since run started
    private morph = 0; // 0 = narrow container, 1 = wide container
    private raf = 0;
    private seconds = 6;

    connectedCallback() {
      this.seconds = Number(this.dataset.seconds);
      const canvas = this.querySelector('canvas')!;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      this.ctx = canvas.getContext('2d')!;
      this.ctx.scale(dpr, dpr);
      this.reset();
      for (let i = 0; i < 200; i++) this.step();
      this.draw();
      new MutationObserver(() => this.draw()).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    }

    private box() {
      const e = this.morph < 0.5 ? 2 * this.morph * this.morph : 1 - (-2 * this.morph + 2) ** 2 / 2; // ease in-out
      return { w: NARROW.w + (WIDE.w - NARROW.w) * e, h: NARROW.h + (WIDE.h - NARROW.h) * e };
    }

    private reset() {
      cancelAnimationFrame(this.raf);
      this.t = 0;
      this.morph = 0;
      const lane = (kind: Kind, cx: number): Lane => {
        const ps: P[] = [];
        const add = (x: number, y: number) => ps.push({ x, y, vx: 0, vy: 0, hx: x - cx, hy: y });
        if (kind === 'solid') {
          // A tall block that fills the narrow container, like ice frozen in a jar.
          for (let r = 0; r < 9; r++) for (let c = 0; c < 4; c++) add(cx - 24 + c * 16, FLOOR - R - r * 16);
        } else if (kind === 'liquid') {
          for (let r = 0; r < 9; r++) for (let c = 0; c < 4; c++) add(cx - 24 + c * 16 + (r % 2) * 3, FLOOR - R - r * 15);
        } else {
          for (let i = 0; i < 16; i++) {
            const a = Math.random() * Math.PI * 2;
            ps.push({ x: cx - 25 + Math.random() * 50, y: FLOOR - 20 - Math.random() * 150, vx: Math.cos(a) * 2.2, vy: Math.sin(a) * 2.2, hx: 0, hy: 0 });
          }
        }
        return { kind, cx, ps };
      };
      this.lanes = [lane('solid', 110), lane('liquid', 330), lane('gas', 550)];
    }

    /** Starts the experiment. Resolves when the animation has finished. */
    run(): Promise<void> {
      this.reset();
      for (let i = 0; i < 200; i++) this.step();
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      return new Promise((resolve) => {
        let last = performance.now();
        const frame = (now: number) => {
          const steps = Math.max(1, Math.round(Math.min(now - last, 100) / 16.67)) * (reduce ? 3 : 1);
          last = now;
          for (let i = 0; i < steps; i++) {
            this.t += 1 / 60;
            // Hold for a moment, then change the containers over 1.2 seconds.
            this.morph = Math.min(1, Math.max(0, (this.t - 0.6) / 1.2));
            this.step();
          }
          this.draw();
          if (this.t < this.seconds) this.raf = requestAnimationFrame(frame);
          else {
            this.querySelector('[data-cs="live"]')!.textContent =
              'The solid kept its tall shape. The liquid spread out to cover the bottom of the wide container. The gas spread out to fill the whole container.';
            resolve();
          }
        };
        this.raf = requestAnimationFrame(frame);
      });
    }

    private step() {
      const { w, h } = this.box();
      for (const lane of this.lanes) {
        const left = lane.cx - w / 2 + R;
        const right = lane.cx + w / 2 - R;
        const top = FLOOR - h + R;
        const bottom = FLOOR - R;
        const ps = lane.ps;
        for (const p of ps) {
          if (lane.kind === 'solid') {
            // Held in place by strong attractions: the whole block stays the same shape.
            const tx = lane.cx + p.hx;
            const ty = p.hy;
            p.vx = (p.vx + (tx - p.x) * 0.2 + (Math.random() - 0.5) * 0.8) * 0.6;
            p.vy = (p.vy + (ty - p.y) * 0.2 + (Math.random() - 0.5) * 0.8) * 0.6;
          } else if (lane.kind === 'liquid') {
            p.vy += 0.25;
            p.vx += (Math.random() - 0.5) * 1.1;
            p.vx *= 0.92;
            p.vy *= 0.92;
          } else {
            const sp = Math.hypot(p.vx, p.vy) || 0.01;
            const k = 1 + (3 / sp - 1) * 0.08;
            p.vx = p.vx * k + (Math.random() - 0.5) * 0.3;
            p.vy = p.vy * k + (Math.random() - 0.5) * 0.3;
          }
          p.x += p.vx;
          p.y += p.vy;
          if (lane.kind === 'solid') continue;
          if (p.x < left) { p.x = left; p.vx = Math.abs(p.vx); }
          if (p.x > right) { p.x = right; p.vx = -Math.abs(p.vx); }
          if (lane.kind === 'gas' && p.y < top) { p.y = top; p.vy = Math.abs(p.vy); }
          if (p.y > bottom) { p.y = bottom; p.vy = -Math.abs(p.vy) * (lane.kind === 'gas' ? 1 : 0.2); }
        }
        if (lane.kind === 'solid') continue;
        // Particles never overlap.
        for (let pass = 0; pass < 3; pass++)
          for (let i = 0; i < ps.length; i++)
            for (let j = i + 1; j < ps.length; j++) {
              const a = ps[i];
              const b = ps[j];
              const dx = b.x - a.x;
              const dy = b.y - a.y;
              const d = Math.hypot(dx, dy) || 0.01;
              const o = 2 * R + 0.5 - d;
              if (o <= 0) continue;
              const ox = (dx / d) * (o / 2);
              const oy = (dy / d) * (o / 2);
              a.x -= ox; a.y -= oy; b.x += ox; b.y += oy;
              if (lane.kind === 'gas') { [a.vx, b.vx] = [b.vx, a.vx]; [a.vy, b.vy] = [b.vy, a.vy]; }
            }
        for (const p of ps) {
          p.x = Math.min(right, Math.max(left, p.x));
          p.y = Math.min(bottom, Math.max(lane.kind === 'gas' ? top : -999, p.y));
        }
      }
    }

    private draw() {
      const c = this.ctx;
      const cs = getComputedStyle(this);
      const ink = cs.getPropertyValue('--ink-2').trim() || '#444';
      const dot = cs.getPropertyValue('--accent').trim() || '#187a50';
      const font = cs.fontFamily;
      const { w, h } = this.box();
      c.clearRect(0, 0, W, H);
      for (const lane of this.lanes) {
        const x0 = lane.cx - w / 2;
        c.strokeStyle = ink;
        c.lineWidth = 3;
        c.beginPath();
        c.moveTo(x0 - 2, FLOOR - h - 6);
        c.lineTo(x0 - 2, FLOOR + 2);
        c.lineTo(x0 + w + 2, FLOOR + 2);
        c.lineTo(x0 + w + 2, FLOOR - h - 6);
        if (lane.kind === 'gas') c.lineTo(x0 - 2, FLOOR - h - 6); // closed lid keeps the gas in
        c.stroke();
        c.fillStyle = dot;
        for (const p of lane.ps) {
          c.beginPath();
          c.arc(p.x, p.y, R, 0, Math.PI * 2);
          c.fill();
        }
        c.fillStyle = ink;
        c.font = `700 16px ${font}`;
        c.textAlign = 'center';
        c.fillText(LABELS[lane.kind], lane.cx, H - 18);
      }
    }
  }
  customElements.define('container-swap', ContainerSwap);
</script>
