---
// Animated experiment: leftover paint is poured into a storm drain, then it rains. The water and
// paint run through the storm pipe straight into the river, with no cleaning on the way
// (SCI4-OI1-GQ1-LO1, U2.1, S2.2). Calgary: storm drains reach rivers without treatment.
---
<g4-storm-drain>
  <svg class="sci-svg" viewBox="0 0 660 300" aria-hidden="true" data-g4s="svg"></svg>
  <p class="sr-only" aria-live="polite" data-g4s="live"></p>
</g4-storm-drain>

<style is:global>
  g4-storm-drain { display: block; }
  .g4s-road { fill: #6b6f78; }
  .g4s-earth { fill: #8b6a45; }
  .g4s-pipe { fill: none; stroke: #9aa1ab; stroke-width: 18; stroke-linejoin: round; }
  .g4s-pipe-in { fill: none; stroke: #3d4249; stroke-width: 10; stroke-linejoin: round; }
  .g4s-grate { fill: #2a2d33; stroke: #9aa1ab; stroke-width: 2; }
  .g4s-river { fill: #3f86c9; }
  .g4s-paint { fill: #d14fc2; }
  .g4s-rain { stroke: #7fb2e5; stroke-width: 2; stroke-linecap: round; }
  .g4s-fish { fill: #f2a33a; stroke: #8a4f12; stroke-width: 1.5; }
  .g4s-lbl { fill: #fff; font-size: 14px; font-weight: 700; paint-order: stroke; stroke: rgba(0, 0, 0, 0.45); stroke-width: 3px; }
  .g4s-warn { fill: #fff; font-size: 15px; font-weight: 700; paint-order: stroke; stroke: #8a1c13; stroke-width: 4px; }
</style>

<script>
  import { tween, wait } from './anim.ts';

  const ROAD = 120; // top of the road
  const DRAIN = 150; // x of the storm drain grate
  // The storm pipe: down from the grate, along under the ground, out into the river bank.
  const PIPE: [number, number][] = [
    [DRAIN, ROAD + 8],
    [DRAIN, 220],
    [500, 220],
    [540, 190],
  ];
  const RIVER_X = 545;

  /** A point part-way along the pipe, t from 0 to 1. */
  function along(t: number): [number, number] {
    const segs = PIPE.slice(1).map((p, i) => Math.hypot(p[0] - PIPE[i][0], p[1] - PIPE[i][1]));
    let d = t * segs.reduce((a, b) => a + b, 0);
    for (let i = 0; i < segs.length; i++) {
      if (d <= segs[i] || i === segs.length - 1) {
        const k = Math.min(1, d / segs[i]);
        return [PIPE[i][0] + (PIPE[i + 1][0] - PIPE[i][0]) * k, PIPE[i][1] + (PIPE[i + 1][1] - PIPE[i][1]) * k];
      }
      d -= segs[i];
    }
    return PIPE[PIPE.length - 1];
  }

  class G4StormDrain extends HTMLElement {
    private spill = 0; // 0..1: paint poured on the road
    private rain = 0; // 0..1: rain falling
    private flow = 0; // 0..1: paint travelling through the pipe
    private stain = 0; // 0..1: paint spreading in the river
    private done = false;

    connectedCallback() {
      this.draw();
    }

    async run() {
      this.spill = this.rain = this.flow = this.stain = 0;
      this.done = false;
      this.querySelector('[data-g4s="live"]')!.textContent = '';
      await tween(900, (t) => {
        this.spill = t;
        this.draw();
      });
      await wait(250);
      await tween(3200, (t) => {
        this.rain = Math.min(1, t * 3);
        this.flow = Math.min(1, t * 1.35);
        this.stain = Math.max(0, (t - 0.7) / 0.3);
        this.draw();
      });
      this.done = true;
      this.draw();
      this.querySelector('[data-g4s="live"]')!.textContent =
        'The rain washed the paint into the storm drain. It ran through the pipe and poured straight into the river. Nothing cleaned it on the way.';
    }

    private draw() {
      const out: string[] = ['<rect class="sci-sky" width="660" height="300"/>'];
      // Ground, road and river.
      out.push(`<rect class="g4s-earth" x="0" y="${ROAD + 14}" width="${RIVER_X}" height="${300 - ROAD}"/>`);
      out.push(`<rect class="g4s-road" x="0" y="${ROAD}" width="330" height="14"/><rect class="sci-ground" x="330" y="${ROAD}" width="${RIVER_X - 330}" height="14"/>`);
      out.push(`<path class="g4s-river" d="M${RIVER_X - 10},${ROAD + 14} Q${RIVER_X + 10},210 ${RIVER_X - 5},300 L660,300 L660,${ROAD + 14} Z"/>`);
      // Paint spreading in the river.
      if (this.stain > 0)
        out.push(`<ellipse class="g4s-paint" cx="${RIVER_X + 50}" cy="200" rx="${(18 + 50 * this.stain).toFixed(1)}" ry="${(10 + 28 * this.stain).toFixed(1)}" opacity="0.6"/>`);
      // Fish swim away from the paint.
      const fx = 600 + 40 * this.stain;
      out.push(`<g transform="translate(${fx.toFixed(1)} 250)"><path class="g4s-fish" d="M0,0 q12,-10 24,0 q-12,10 -24,0 Z M24,0 l10,-7 l0,14 Z"/></g>`);
      // House.
      out.push('<rect x="20" y="62" width="70" height="58" style="fill:#e8d7a8;stroke:var(--ink);stroke-width:2"/><path d="M14,64 L55,30 L96,64 Z" style="fill:#c0563a;stroke:var(--ink);stroke-width:2"/><rect x="46" y="88" width="18" height="32" style="fill:#7a5232"/>');
      // The storm pipe.
      const d = 'M' + PIPE.map((p) => p.join(',')).join(' L');
      out.push(`<path class="g4s-pipe" d="${d}"/><path class="g4s-pipe-in" d="${d}"/>`);
      out.push(`<rect class="g4s-grate" x="${DRAIN - 16}" y="${ROAD}" width="32" height="8"/>`);
      // Paint on the road, which the rain washes toward the drain.
      if (this.spill > 0) {
        const left = 250 - 70 * this.spill;
        const shrink = 1 - Math.min(1, this.flow * 2);
        const w = (60 + 40 * this.spill) * shrink;
        if (w > 1) out.push(`<ellipse class="g4s-paint" cx="${(left - (left - DRAIN) * (1 - shrink)).toFixed(1)}" cy="${ROAD + 3}" rx="${(w / 2).toFixed(1)}" ry="4"/>`);
        out.push(`<g transform="translate(${260 + 10 * (1 - this.spill)} ${ROAD - 30}) rotate(${(-60 * this.spill).toFixed(1)})"><rect x="-10" y="-14" width="20" height="26" rx="3" style="fill:#b8c0cc;stroke:var(--ink);stroke-width:2"/><rect x="-10" y="-4" width="20" height="8" class="g4s-paint"/></g>`);
      }
      // Blobs of paint travelling through the pipe.
      if (this.flow > 0 && this.flow < 1)
        for (let k = 0; k < 6; k++) {
          const t = this.flow - k * 0.04;
          if (t <= 0 || t >= 1) continue;
          const [x, y] = along(t);
          out.push(`<circle class="g4s-paint" cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="5"/>`);
        }
      // Rain.
      if (this.rain > 0)
        for (let k = 0; k < 26; k++) {
          const x = (k * 37) % 520 + 10;
          const y = (k * 53 + this.flow * 900) % ROAD;
          out.push(`<line class="g4s-rain" x1="${x}" y1="${y.toFixed(1)}" x2="${x - 3}" y2="${(y + 10).toFixed(1)}" opacity="${this.rain.toFixed(2)}"/>`);
        }
      out.push(`<text class="g4s-lbl" x="${DRAIN}" y="${ROAD + 34}" text-anchor="middle">Storm drain</text>`);
      out.push('<text class="g4s-lbl" x="330" y="244" text-anchor="middle">Storm pipe</text>');
      out.push(`<text class="g4s-lbl" x="${RIVER_X + 60}" y="150" text-anchor="middle">River</text>`);
      if (this.done) out.push(`<text class="g4s-warn" x="330" y="286" text-anchor="middle">No cleaning on the way: the paint reached the river.</text>`);
      this.querySelector('[data-g4s="svg"]')!.innerHTML = out.join('');
    }
  }
  customElements.define('g4-storm-drain', G4StormDrain);
</script>
