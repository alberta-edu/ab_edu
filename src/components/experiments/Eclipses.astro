---
// Animated experiment: a solar eclipse (the Moon passes between the Sun and Earth) and a lunar
// eclipse (Earth passes between the Sun and the Moon), each with what it looks like from Earth
// (SCI5-OI5-GQ1-LO1, K1.2, S1.3).
---
<eclipse-show>
  <svg class="sci-svg ec-svg" viewBox="0 0 660 320" aria-hidden="true" data-ec="svg"></svg>
  <p class="sr-only" aria-live="polite" data-ec="live"></p>
</eclipse-show>

<style is:global>
  eclipse-show { display: block; }
  .ec-svg { background: #0f1830; }
  .ec-sun { fill: #ffcf3d; }
  .ec-earth { fill: #4f9de0; stroke: #8fb3ff; stroke-width: 1; }
  .ec-moon { fill: #c9c4b0; }
  .ec-shadow { fill: #000; opacity: 0.55; }
  .ec-title { fill: #fff; font-size: 16px; font-weight: 700; }
  .ec-frame { fill: none; stroke: #4a5a86; stroke-width: 1.5; }
</style>

<script>
  import { tween, wait } from './anim.ts';

  const ROW = [20, 175]; // top of each row
  const H = 140;

  const mix = (a: [number, number, number], b: [number, number, number], t: number) => `rgb(${a.map((v, i) => Math.round(v + (b[i] - v) * t)).join(',')})`;

  class EclipseShow extends HTMLElement {
    private t = 0; // 0 = the Moon is off to the side, 1 = lined up

    connectedCallback() {
      this.draw();
    }

    async run() {
      this.querySelector('[data-ec="live"]')!.textContent = '';
      await tween(4500, (t) => {
        this.t = t;
        this.draw();
      });
      await wait(200);
      this.querySelector('[data-ec="live"]')!.textContent =
        'Solar eclipse: the Moon covered the Sun and the daytime sky went dark. Lunar eclipse: the full Moon moved into Earth’s shadow and turned a dark, reddish colour.';
    }

    private draw() {
      const out: string[] = [];
      const off = (1 - this.t) * 60; // how far the Moon is from the line-up
      const cover = Math.max(0, 1 - off / 60);

      // Row 1: solar eclipse. Sun → Moon → Earth.
      let y = ROW[0] + H / 2;
      out.push(`<text class="ec-title" x="16" y="${ROW[0] + 16}">Solar eclipse</text>`);
      out.push(`<circle class="ec-sun" cx="50" cy="${y + 8}" r="34"/>`);
      const mx = 270;
      const my = y - off;
      if (cover > 0.9) out.push(`<path class="ec-shadow" d="M${mx},${my - 8} L400,${y - 3} L400,${y + 3} L${mx},${my + 8} Z"/>`);
      out.push(`<circle class="ec-moon" cx="${mx}" cy="${my.toFixed(1)}" r="8"/>`);
      out.push(`<circle class="ec-earth" cx="400" cy="${y}" r="24"/>`);
      if (cover > 0.9) out.push(`<circle cx="377" cy="${y}" r="4" fill="#000" opacity="0.7"/>`);
      out.push(`<text class="so-text" x="270" y="${ROW[0] + H - 6}" text-anchor="middle">Moon</text><text class="so-text" x="400" y="${ROW[0] + H - 6}" text-anchor="middle">Earth</text>`);
      // From Earth: the Moon slides across the Sun; the sky darkens.
      out.push(`<rect x="450" y="${ROW[0]}" width="194" height="${H}" rx="8" fill="${mix([120, 180, 235], [12, 18, 40], cover * cover)}"/>`);
      // Near totality, the Sun's faint outer glow shows around the dark Moon.
      out.push(`<circle cx="547" cy="${y}" r="52" fill="#fff" opacity="${(0.35 * Math.max(0, (cover - 0.85) / 0.15)).toFixed(2)}"/>`);
      out.push(`<circle class="ec-sun" cx="547" cy="${y}" r="38"/><circle cx="${(547 + off * 1.3).toFixed(1)}" cy="${(y - off * 0.3).toFixed(1)}" r="39" fill="#05080f"/>`);
      out.push(`<text class="ec-title" x="547" y="${ROW[0] + H - 10}" text-anchor="middle">Seen from Earth</text>`);

      // Row 2: lunar eclipse. Sun → Earth → Moon.
      y = ROW[1] + H / 2;
      out.push(`<text class="ec-title" x="16" y="${ROW[1] + 16}">Lunar eclipse</text>`);
      out.push(`<circle class="ec-sun" cx="50" cy="${y + 8}" r="34"/>`);
      out.push(`<path class="ec-shadow" d="M270,${y - 24} L420,${y - 12} L420,${y + 12} L270,${y + 24} Z"/>`);
      out.push(`<circle class="ec-earth" cx="270" cy="${y}" r="24"/>`);
      const lunarRed = Math.max(0, (cover - 0.4) / 0.6);
      out.push(`<circle cx="400" cy="${(y - off).toFixed(1)}" r="9" fill="${mix([241, 236, 216], [150, 60, 35], lunarRed)}"/>`);
      out.push(`<text class="so-text" x="270" y="${ROW[1] + H - 6}" text-anchor="middle">Earth</text><text class="so-text" x="400" y="${ROW[1] + H - 6}" text-anchor="middle">Moon</text>`);
      out.push(`<rect x="450" y="${ROW[1]}" width="194" height="${H}" rx="8" fill="rgb(12,18,40)"/><rect class="ec-frame" x="450" y="${ROW[1]}" width="194" height="${H}" rx="8"/>`);
      out.push(`<circle cx="547" cy="${y - 6}" r="38" fill="${mix([241, 236, 216], [150, 60, 35], lunarRed)}"/>`);
      out.push(`<text class="ec-title" x="547" y="${ROW[1] + H - 10}" text-anchor="middle">Seen from Earth</text>`);
      this.querySelector('[data-ec="svg"]')!.innerHTML = out.join('');
    }
  }
  customElements.define('eclipse-show', EclipseShow);
</script>
