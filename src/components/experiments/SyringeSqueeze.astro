---
// Animated experiment: the same push on two sealed syringes, one full of air and one full of
// water. The air's volume shrinks; the water's hardly changes. Particles show why
// (SCI5-OI1-GQ1-LO1, K2.12, U2.1, S2.6).
---
<syringe-squeeze>
  <svg class="sci-svg" viewBox="0 0 660 300" aria-hidden="true" data-ss="svg"></svg>
  <p class="sr-only" aria-live="polite" data-ss="live"></p>
</syringe-squeeze>

<style is:global>
  syringe-squeeze { display: block; }
  .ss-bg { fill: var(--surface-2); }
  .ss-barrel { fill: var(--surface); stroke: var(--ink-2); stroke-width: 3; }
  .ss-cap { fill: var(--ink-2); }
  .ss-plunger { fill: var(--ink-3); }
  .ss-seal { fill: var(--ink); }
  .ss-air { fill: var(--accent); }
  .ss-water-bg { fill: color-mix(in srgb, var(--math) 16%, transparent); }
  .ss-water { fill: var(--math); }
  .ss-num { fill: var(--ink-2); font-size: 12px; font-weight: 700; }
  .ss-push line { stroke: var(--sun); stroke-width: 6; stroke-linecap: round; }
  .ss-push polygon { fill: var(--sun); }
  .ss-read { fill: var(--accent); font-size: 16px; font-weight: 700; }
</style>

<script>
  import { tween, wait, ease, loopWhileVisible } from './anim.ts';

  const X0 = 110; // inside of the sealed tip
  const PX_PER_ML = 6;
  const FULL = 60;
  const BH = 50; // barrel inside height
  const LANES = [
    { kind: 'air' as const, y: 52, label: 'Air' },
    { kind: 'water' as const, y: 182, label: 'Water' },
  ];
  interface P { x: number; y: number; vx: number; vy: number }

  class SyringeSqueeze extends HTMLElement {
    private vol = { air: FULL, water: FULL };
    private push = 0;
    private air: P[] = [];
    private water: P[] = [];

    connectedCallback() {
      for (let i = 0; i < 16; i++) {
        const a = Math.random() * Math.PI * 2;
        this.air.push({ x: X0 + 10 + Math.random() * 340, y: 8 + Math.random() * (BH - 16), vx: Math.cos(a) * 110, vy: Math.sin(a) * 110 });
      }
      for (let c = 0; c < 30; c++) for (let r = 0; r < 4; r++) this.water.push({ x: X0 + 6 + c * 11.9 + (r % 2) * 3, y: 7 + r * 12, vx: 0, vy: 0 });
      this.draw();
      loopWhileVisible(this, (dt) => {
        this.move(dt);
        this.draw();
      });
    }

    async run() {
      this.querySelector('[data-ss="live"]')!.textContent = '';
      this.vol = { air: FULL, water: FULL };
      await wait(300);
      await tween(1600, (t) => {
        const e = ease(t);
        this.push = e;
        this.vol.air = FULL - 30 * e;
        this.vol.water = FULL - 0.4 * e;
      });
      await wait(900);
      this.querySelector('[data-ss="live"]')!.textContent =
        'With the same push, the air was squeezed from 60 mL to 30 mL. The water stayed at about 60 mL.';
    }

    private move(dt: number) {
      const right = X0 + this.vol.air * PX_PER_ML - 6;
      for (const p of this.air) {
        p.x += p.vx * dt;
        p.y += p.vy * dt;
        if (p.x < X0 + 6) { p.x = X0 + 6; p.vx = Math.abs(p.vx); }
        if (p.x > right) { p.x = right; p.vx = -Math.abs(p.vx); }
        if (p.y < 6) { p.y = 6; p.vy = Math.abs(p.vy); }
        if (p.y > BH - 6) { p.y = BH - 6; p.vy = -Math.abs(p.vy); }
      }
    }

    private draw() {
      const out: string[] = ['<rect class="ss-bg" width="660" height="300"/>'];
      for (const lane of LANES) {
        const vol = this.vol[lane.kind];
        const px = X0 + vol * PX_PER_ML; // plunger face
        const y = lane.y;
        out.push(`<text class="sci-text" x="20" y="${y + BH / 2 + 6}">${lane.label}</text>`);
        out.push(`<rect class="ss-cap" x="${X0 - 26}" y="${y + BH / 2 - 7}" width="22" height="14" rx="3"/>`);
        out.push(`<rect class="ss-barrel" x="${X0 - 4}" y="${y - 4}" width="${FULL * PX_PER_ML + 8}" height="${BH + 8}" rx="6"/>`);
        if (lane.kind === 'water') out.push(`<rect class="ss-water-bg" x="${X0}" y="${y}" width="${px - X0}" height="${BH}"/>`);
        const ps = lane.kind === 'air' ? this.air : this.water;
        const squeeze = (px - X0) / (FULL * PX_PER_ML);
        for (const p of ps) {
          const x = lane.kind === 'air' ? p.x : X0 + (p.x - X0) * squeeze + (Math.random() - 0.5) * 1.6;
          const yy = y + p.y + (lane.kind === 'water' ? (Math.random() - 0.5) * 1.6 : 0);
          out.push(`<circle class="ss-${lane.kind}" cx="${x.toFixed(1)}" cy="${yy.toFixed(1)}" r="5"/>`);
        }
        // Plunger: seal, rod and thumb pad.
        const padX = px + 80;
        out.push(`<rect class="ss-seal" x="${px}" y="${y}" width="10" height="${BH}" rx="2"/>`);
        out.push(`<rect class="ss-plunger" x="${px + 10}" y="${y + BH / 2 - 5}" width="70" height="10"/>`);
        out.push(`<rect class="ss-seal" x="${padX}" y="${y - 8}" width="10" height="${BH + 16}" rx="3"/>`);
        if (this.push > 0) {
          const my = y + BH / 2;
          out.push(`<g class="ss-push"><line x1="${padX + 70}" y1="${my}" x2="${padX + 26}" y2="${my}"/><polygon points="${padX + 14},${my} ${padX + 28},${my - 9} ${padX + 28},${my + 9}"/></g><text class="sci-small" x="${padX + 46}" y="${y - 12}" text-anchor="middle">same push</text>`);
        }
        // Scale every 10 mL.
        for (let m = 10; m <= FULL; m += 10) {
          const x = X0 + m * PX_PER_ML;
          out.push(`<line class="sci-tick" x1="${x}" y1="${y + BH + 4}" x2="${x}" y2="${y + BH + 12}"/><text class="ss-num" x="${x}" y="${y + BH + 26}" text-anchor="middle">${m}</text>`);
        }
        out.push(`<text class="ss-read" x="20" y="${y + BH / 2 + 28}">${Math.round(vol)} mL</text>`);
      }
      this.querySelector('[data-ss="svg"]')!.innerHTML = out.join('');
    }
  }
  customElements.define('syringe-squeeze', SyringeSqueeze);
</script>
