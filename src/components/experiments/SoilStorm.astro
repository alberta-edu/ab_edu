---
// Animated experiment: the same windstorm blows across two fields. One was tilled and left
// bare; the other was not tilled and keeps last year's stubble as soil cover. The bare soil
// blows away (SCI5-OI3-GQ1-LO1, K4.2, K4.4, K4.5).
---
<soil-storm>
  <svg class="sci-svg" viewBox="0 0 660 300" aria-hidden="true" data-st="svg"></svg>
  <p class="sr-only" aria-live="polite" data-st="live"></p>
</soil-storm>

<style is:global>
  soil-storm { display: block; }
  .st-soil { fill: #8b5a2b; }
  .st-soil-top { fill: #6e4320; }
  .st-dust { fill: #a8743d; }
  .st-stubble { stroke: #c9a13b; stroke-width: 3; stroke-linecap: round; }
  .st-wind { stroke: var(--ink-3); stroke-width: 2.5; stroke-linecap: round; fill: none; }
  .st-label { fill: var(--ink); font-size: 15px; font-weight: 700; }
  .st-result-bad { fill: var(--bad); font-size: 15px; font-weight: 700; }
  .st-result-ok { fill: var(--ok); font-size: 15px; font-weight: 700; }
  .st-divider { stroke: var(--line-strong); stroke-width: 2; stroke-dasharray: 6 6; }
</style>

<script>
  import { tween, wait } from './anim.ts';

  const GROUND = 220;
  const FIELDS = [
    { x0: 20, x1: 315, cover: false, label: 'Tilled, bare soil' },
    { x0: 345, x1: 640, cover: true, label: 'Not tilled, stubble left on' },
  ];
  interface Grain { x: number; y: number; vx: number; vy: number }

  class SoilStorm extends HTMLElement {
    private depth = [70, 70]; // soil thickness in px
    private grains: Grain[][] = [[], []];
    private wind = 0;
    private t = 0;
    private done = false;

    connectedCallback() {
      this.draw();
    }

    async run() {
      this.depth = [70, 70];
      this.grains = [[], []];
      this.done = false;
      this.querySelector('[data-st="live"]')!.textContent = '';
      await tween(5200, (t) => {
        this.t = t;
        this.wind = Math.min(1, t * 4) * Math.min(1, (1 - t) * 6);
        FIELDS.forEach((f, i) => {
          // Bare soil loses grains all through the storm; stubble holds almost all of it.
          const rate = f.cover ? 0.04 : 1;
          if (Math.random() < this.wind * rate * 0.9 && this.depth[i] > 22) {
            for (let k = 0; k < 3; k++)
              this.grains[i].push({ x: f.x0 + Math.random() * (f.x1 - f.x0), y: GROUND - this.depth[i], vx: 3 + Math.random() * 4, vy: -1 - Math.random() * 2.5 });
            this.depth[i] -= 0.12 * rate * 3;
          }
          for (const g of this.grains[i]) {
            g.x += g.vx * this.wind + 0.5;
            g.y += g.vy;
            g.vy += 0.05;
            if (g.y > GROUND - this.depth[i] - 2) g.vy = -Math.abs(g.vy) * 0.6;
          }
          this.grains[i] = this.grains[i].filter((g) => g.x < f.x1 + 10 && g.y > 0);
        });
        this.draw();
      });
      this.done = true;
      this.draw();
      await wait(200);
      this.querySelector('[data-st="live"]')!.textContent =
        'The bare, tilled field lost much of its top soil to the wind. The field with stubble kept its soil.';
    }

    private draw() {
      const out: string[] = ['<rect class="sci-sky" width="660" height="300"/>', '<line class="st-divider" x1="330" y1="20" x2="330" y2="280"/>'];
      // Wind lines while the storm blows.
      if (this.wind > 0.05)
        for (let k = 0; k < 8; k++) {
          const y = 40 + k * 20;
          const x = ((k * 97 + this.t * 3000) % 760) - 100;
          out.push(`<path class="st-wind" opacity="${this.wind.toFixed(2)}" d="M${x},${y} q20,-8 40,0 t40,0"/>`);
        }
      FIELDS.forEach((f, i) => {
        const top = GROUND - this.depth[i];
        out.push(`<rect class="st-soil" x="${f.x0}" y="${top.toFixed(1)}" width="${f.x1 - f.x0}" height="${(300 - top).toFixed(1)}"/>`);
        if (!f.cover) {
          // Tilled furrows on the bare field.
          for (let x = f.x0 + 10; x < f.x1; x += 22) out.push(`<path class="st-soil-top" d="M${x},${top} l11,-6 l11,6 Z"/>`);
        } else {
          for (let x = f.x0 + 6; x < f.x1; x += 9) {
            const lean = Math.sin(x + this.t * 40) * 3 * this.wind + 3 * this.wind;
            out.push(`<line class="st-stubble" x1="${x}" y1="${top}" x2="${(x + lean).toFixed(1)}" y2="${top - 16 - ((x * 7) % 6)}"/>`);
          }
        }
        for (const g of this.grains[i]) out.push(`<circle class="st-dust" cx="${g.x.toFixed(1)}" cy="${g.y.toFixed(1)}" r="2.5"/>`);
        const cx = (f.x0 + f.x1) / 2;
        if (this.done && !f.cover) out.push(`<line class="st-divider" x1="${f.x0}" y1="${GROUND - 70}" x2="${f.x1}" y2="${GROUND - 70}"/><text class="sci-small" x="${f.x0 + 4}" y="${GROUND - 76}">soil level before the storm</text>`);
        out.push(`<text class="st-label" x="${cx}" y="262" text-anchor="middle" style="fill:#fff">${f.label}</text>`);
        if (this.done)
          out.push(f.cover ? `<text class="st-result-ok" x="${cx}" y="26" text-anchor="middle">✓ Soil stayed in place</text>` : `<text class="st-result-bad" x="${cx}" y="26" text-anchor="middle">✗ Top soil blew away</text>`);
      });
      this.querySelector('[data-st="svg"]')!.innerHTML = out.join('');
    }
  }
  customElements.define('soil-storm', SoilStorm);
</script>
