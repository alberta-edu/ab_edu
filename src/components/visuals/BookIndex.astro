---
// A small information book with an index (LANENG4-OI1-GQ1-LO1, K2.1, U2.1, S2.1). Tap an index entry
// and the book turns to that page with the word marked. Switch the images and graphics off to see
// what information goes missing from the main body.
import { mdInline } from '../../lib/render.ts';

interface Props {
  title: string;
  pages: { n: number; heading: string; text: string; image: string; caption: string }[];
  index: { term: string; pages: number[] }[];
}
const { title, pages, index } = Astro.props;
for (const e of index) for (const n of e.pages) if (!pages.some((p) => p.n === n)) throw new Error(`book-index: "${e.term}" points to missing page ${n}`);
const data = { pages: pages.map((p) => ({ ...p, text: mdInline(p.text), caption: mdInline(p.caption) })), index };
---
<book-index data-book={JSON.stringify(data)}>
  <div class="g4e-ix">
    <section class="g4e-ix__index" aria-label="Index">
      <h3 class="g4e-ix__head">Index</h3>
      <ul>
        {index.map((e, i) => (
          <li>
            <button type="button" data-ix-term={i} aria-pressed="false">{e.term}</button>
            <span class="g4e-ix__nums">{e.pages.join(', ')}</span>
          </li>
        ))}
      </ul>
    </section>
    <article class="g4e-ix__page" aria-live="polite">
      <p class="g4e-ix__book">{title}</p>
      <h3 data-ix="heading"></h3>
      <figure class="g4e-ix__pic" data-ix="pic">
        <span data-ix="image" aria-hidden="true"></span>
        <figcaption data-ix="caption"></figcaption>
      </figure>
      <p data-ix="text"></p>
      <p class="g4e-ix__num">Page <span data-ix="num"></span></p>
    </article>
  </div>
  <div class="control-row">
    <span class="g4e-ix__goto" data-ix="goto"></span>
    <label class="control"><input type="checkbox" data-ix="images" checked /> Images and graphics</label>
  </div>
  <noscript>
    <ul>{pages.map((p) => <li><strong>Page {p.n}, {p.heading}:</strong> <span set:html={mdInline(p.text)} /> ({p.image} <span set:html={mdInline(p.caption)} />)</li>)}</ul>
  </noscript>
</book-index>

<style is:global>
  book-index { display: block; }
  .g4e-ix { display: grid; grid-template-columns: minmax(9rem, 1fr) 2fr; gap: 0.8rem; align-items: start; }
  .g4e-ix__index { padding: 0.6rem 0.8rem; border-radius: var(--radius-sm); background: var(--surface-2); }
  .g4e-ix__head { margin: 0 0 0.3rem; font-size: var(--step-0); }
  .g4e-ix__index ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.2rem; }
  .g4e-ix__index li { display: flex; justify-content: space-between; gap: 0.4rem; align-items: baseline; }
  .g4e-ix__index button { padding: 0.25rem 0.4rem; border: 0; border-radius: 6px; background: none; font: inherit; color: var(--accent); text-decoration: underline; cursor: pointer; text-align: left; }
  .g4e-ix__index button[aria-pressed='true'] { background: var(--accent-soft); color: var(--ink); font-weight: 700; text-decoration: none; }
  .g4e-ix__nums { color: var(--ink-2); font-size: var(--step--1); white-space: nowrap; }
  .g4e-ix__page { position: relative; min-height: 15rem; padding: 0.9rem 1rem 1.8rem; border: 2px solid var(--line-strong); border-radius: 4px var(--radius-sm) var(--radius-sm) 4px; background: var(--surface); box-shadow: var(--shadow); }
  .g4e-ix__book { margin: 0; font-size: var(--step--1); color: var(--ink-3); }
  .g4e-ix__page h3 { margin: 0.1rem 0 0.4rem; }
  .g4e-ix__page p { margin: 0.4rem 0 0; }
  .g4e-ix__page mark { background: var(--sun); color: #1c1b24; border-radius: 3px; padding: 0 0.15em; }
  .g4e-ix__pic { margin: 0; display: flex; gap: 0.6rem; align-items: center; padding: 0.4rem 0.6rem; border-radius: var(--radius-sm); background: var(--accent-soft); }
  .g4e-ix__pic span { font-size: 2.2rem; line-height: 1; }
  .g4e-ix__pic figcaption { font-size: var(--step--1); }
  .g4e-ix__pic[hidden] { display: none; }
  .g4e-ix__num { position: absolute; right: 0.9rem; bottom: 0.4rem; font-size: var(--step--1); color: var(--ink-3); }
  .g4e-ix__goto { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  @media (prefers-reduced-motion: no-preference) {
    .g4e-ix__page.is-turning { animation: g4e-ix-turn 0.35s ease; }
    @keyframes g4e-ix-turn { from { transform: perspective(600px) rotateY(-12deg); opacity: 0.4; } }
  }
  @media (max-width: 34rem) { .g4e-ix { grid-template-columns: 1fr; } }
</style>

<script>
  type Page = { n: number; heading: string; text: string; image: string; caption: string };
  type Data = { pages: Page[]; index: { term: string; pages: number[] }[] };

  class BookIndex extends HTMLElement {
    private data!: Data;
    private term = -1;

    connectedCallback() {
      this.data = JSON.parse(this.dataset.book!);
      this.querySelectorAll<HTMLButtonElement>('[data-ix-term]').forEach((b) => b.addEventListener('click', () => this.pick(Number(b.dataset.ixTerm))));
      this.part('images').addEventListener('change', () => (this.part('pic').hidden = !(this.part('images') as HTMLInputElement).checked));
      this.show(this.data.pages[0].n);
    }

    private part(name: string) {
      return this.querySelector<HTMLElement>(`[data-ix="${name}"]`)!;
    }

    private pick(i: number) {
      this.term = i;
      this.querySelectorAll('[data-ix-term]').forEach((b) => b.setAttribute('aria-pressed', String(Number(b.getAttribute('data-ix-term')) === i)));
      const nums = this.data.index[i].pages;
      const goto = this.part('goto');
      goto.innerHTML = nums.length > 1 ? nums.map((n) => `<button type="button" class="btn btn--ghost btn--small" data-ix-go="${n}">Page ${n}</button>`).join('') : '';
      goto.querySelectorAll<HTMLButtonElement>('[data-ix-go]').forEach((b) => b.addEventListener('click', () => this.show(Number(b.dataset.ixGo))));
      this.show(nums[0]);
    }

    private show(n: number) {
      const p = this.data.pages.find((x) => x.n === n)!;
      const term = this.term >= 0 ? this.data.index[this.term].term : '';
      // An entry like "owls, burrowing" is found in the text by its first word.
      const key = term.split(',')[0].trim();
      const mark = (html: string) => (key ? html.replace(new RegExp(`\\b(${key.replace(/s$/, '')}\\w*)`, 'gi'), '<mark>$1</mark>') : html);
      this.part('heading').innerHTML = mark(p.heading);
      this.part('image').textContent = p.image;
      this.part('caption').innerHTML = mark(p.caption);
      this.part('text').innerHTML = mark(p.text);
      this.part('num').textContent = String(p.n);
      const page = this.querySelector('.g4e-ix__page')!;
      page.classList.remove('is-turning');
      void (page as HTMLElement).offsetWidth;
      page.classList.add('is-turning');
    }
  }
  customElements.define('book-index', BookIndex);
</script>
