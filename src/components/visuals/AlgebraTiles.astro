---
// Algebra tiles for like terms (MAT6-OI2-GQ1-LO1: K2.1-K2.5, U2.1, S2.1-S2.3). Each term becomes
// tiles: a long tile for x, a square for y, a small square for 1. Next step sorts like terms
// together (commutative property) and combines them; a(b + c) starts as a groups and is expanded.
import { tileSteps } from './g6-algebra.ts';

interface Props {
  examples: string[];
}
const { examples } = Astro.props;
for (const e of examples) tileSteps(e);
const pretty = (e: string) => e.replace(/-/g, '−');
---
<algebra-tiles data-examples={JSON.stringify(examples)}>
  {examples.length > 1 && (
    <div class="seg" role="group" aria-label="Choose an expression">
      {examples.map((e, i) => <button type="button" data-ex={i} aria-pressed={String(i === 0)}>{pretty(e)}</button>)}
    </div>
  )}
  <p class="g6m-at-expr" data-at="expr" aria-live="polite"></p>
  <div class="g6m-at-board" data-at="board" aria-hidden="true"></div>
  <p class="g6m-at-say" data-at="say" aria-live="polite"></p>
  <div class="control-row">
    <button type="button" class="btn btn--ghost btn--small" data-at="back" disabled>◀ Back</button>
    <button type="button" class="btn btn--primary btn--small" data-at="next">Next step ▶</button>
  </div>
  <div class="g6m-at-key" aria-hidden="true">
    <span><span class="g6m-tile g6m-tile--x">x</span> is <i>x</i></span>
    <span><span class="g6m-tile g6m-tile--y">y</span> is <i>y</i></span>
    <span><span class="g6m-tile g6m-tile--1">1</span> is 1</span>
    <span><span class="g6m-tile g6m-tile--1 g6m-tile--neg">1</span> is taken away</span>
  </div>
</algebra-tiles>

<style is:global>
  algebra-tiles { display: block; }
  .g6m-at-expr { margin: 0.8rem 0 0.4rem; font-size: var(--step-2); font-weight: 700; font-variant-numeric: tabular-nums; }
  .g6m-at-board { display: flex; flex-wrap: wrap; gap: 0.8rem; padding: 0.8rem; border-radius: var(--radius); background: var(--surface-2); min-height: 6rem; align-items: flex-end; }
  .g6m-at-group { display: flex; flex-wrap: wrap; gap: 0.3rem; align-items: flex-end; padding: 0.4rem; border-radius: var(--radius-sm); }
  .g6m-at-group--box { border: 2px dashed var(--line-strong); }
  .g6m-at-gap { width: 0.7rem; }
  .g6m-tile { display: inline-grid; place-items: center; font-weight: 800; font-style: italic; border: 2px solid var(--ink); border-radius: 5px; animation: g6m-pop 0.3s ease; }
  .g6m-tile--x { width: 1.5rem; height: 4.2rem; background: color-mix(in srgb, var(--math) 55%, var(--surface)); }
  .g6m-tile--y { width: 2.8rem; height: 2.8rem; background: color-mix(in srgb, var(--ok) 45%, var(--surface)); }
  .g6m-tile--1 { width: 1.5rem; height: 1.5rem; font-style: normal; font-size: 0.8rem; background: var(--sun); color: #1c1b24; }
  .g6m-tile--neg { background: var(--surface); border-style: dashed; border-color: var(--bad); color: var(--bad); }
  .g6m-at-key { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; margin-top: 0.6rem; color: var(--ink-2); font-size: var(--step--1); }
  .g6m-at-key > span { display: inline-flex; align-items: center; gap: 0.3rem; white-space: nowrap; margin-right: 0.6rem; }
  .g6m-at-key .g6m-tile { animation: none; }
  .g6m-at-key .g6m-tile--x { height: 2.4rem; width: 1rem; }
  .g6m-at-key .g6m-tile--y { width: 1.6rem; height: 1.6rem; }
  .g6m-at-say { min-height: 3em; margin: 0.6rem 0 0; }
  @media (prefers-reduced-motion: reduce) { .g6m-tile { animation: none; } }
</style>

<script>
  import { tileSteps, type TileStep, type Term } from './g6-algebra.ts';

  const tiles = (t: Term) => {
    const kind = t.v === '' ? '1' : t.v === 'x' ? 'x' : 'y';
    const one = `<span class="g6m-tile g6m-tile--${kind}${t.c < 0 ? ' g6m-tile--neg' : ''}">${t.v || '1'}</span>`;
    return one.repeat(Math.abs(t.c));
  };

  class AlgebraTiles extends HTMLElement {
    private list: TileStep[] = [];
    private i = 0;

    connectedCallback() {
      const examples: string[] = JSON.parse(this.dataset.examples!);
      const load = (k: number) => {
        this.list = tileSteps(examples[k]);
        this.go(0);
      };
      this.querySelectorAll<HTMLButtonElement>('[data-ex]').forEach((b) =>
        b.addEventListener('click', () => {
          this.querySelectorAll('[data-ex]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          load(Number(b.dataset.ex));
        }),
      );
      this.q('next').addEventListener('click', () => this.go(this.i + 1));
      this.q('back').addEventListener('click', () => this.go(this.i - 1));
      load(0);
    }

    private q<T extends HTMLElement = HTMLElement>(k: string) {
      return this.querySelector(`[data-at="${k}"]`) as T;
    }

    private go(i: number) {
      this.i = Math.max(0, Math.min(this.list.length - 1, i));
      const st = this.list[this.i];
      const boxed = st.groups.length > 1;
      this.q('board').innerHTML = st.groups
        .map((g) => `<div class="g6m-at-group${boxed ? ' g6m-at-group--box' : ''}">${g.map((t, k) => (k && g[k - 1].v !== t.v ? '<span class="g6m-at-gap"></span>' : '') + tiles(t)).join('')}</div>`)
        .join('');
      this.q('expr').textContent = st.expr;
      this.q('say').textContent = st.caption;
      this.q<HTMLButtonElement>('back').disabled = this.i === 0;
      this.q<HTMLButtonElement>('next').disabled = this.i === this.list.length - 1;
    }
  }
  customElements.define('algebra-tiles', AlgebraTiles);
</script>
