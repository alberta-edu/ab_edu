---
// Design lab (SCI5-OI6-GQ1-LO1, K2.1-K2.4, S2.2, S2.5, U2.1): improve a water bottle one change
// at a time. Each change makes a new iteration; the factor bars show the evaluation.
import { CHANGES, FACTORS, FACTOR_QUESTION } from './design-lab.ts';
---
<design-lab data-changes={JSON.stringify(CHANGES)}>
  <div class="dl-layout">
    <div>
      <svg class="sci-svg dl-svg" viewBox="0 0 220 260" role="img" aria-label="The water bottle design" data-dl="art"></svg>
      <p class="dl-version" data-dl="version">Version 1</p>
    </div>
    <div>
      <p class="sci-pick-label">Evaluate it</p>
      <ul class="dl-bars">
        {
          FACTORS.map((f) => (
            <li title={FACTOR_QUESTION[f]}>
              <span class="dl-name">{f[0].toUpperCase() + f.slice(1)}</span>
              <span class="dl-track"><span data-dl-bar={f} /></span>
              <span class="dl-val" data-dl-val={f} />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <p class="sci-pick-label">Make a change (each change is a new iteration)</p>
  <div class="dl-changes">
    {CHANGES.map((c) => <button type="button" class="dl-change" data-dl-change={c.id} aria-pressed="false">{c.label}</button>)}
  </div>
  <div class="control-row"><button type="button" class="btn btn--ghost btn--small" data-dl="reset">Start over</button></div>
  <ol class="dl-log" data-dl="log" aria-live="polite"></ol>
</design-lab>

<style is:global>
  design-lab { display: block; }
  .dl-layout { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); align-items: center; }
  .dl-svg { max-width: 13rem; margin-inline: auto; background: var(--surface-2); }
  .dl-version { text-align: center; font-weight: 700; margin: 0.3rem 0 0; }
  .dl-bars { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.45rem; }
  .dl-bars li { display: grid; grid-template-columns: 6.8rem 1fr 2rem; gap: 0.5rem; align-items: center; font-size: var(--step--1); font-weight: 700; }
  .dl-track { height: 12px; border-radius: 999px; background: var(--surface-3); overflow: hidden; }
  .dl-track span { display: block; height: 100%; border-radius: inherit; background: var(--accent); transition: width 0.4s ease; }
  .dl-track span.is-down { background: var(--bad); }
  .dl-val { text-align: right; font-variant-numeric: tabular-nums; }
  .dl-changes { display: grid; gap: 0.4rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .dl-change { text-align: left; border: 2px solid var(--line); background: var(--surface); border-radius: var(--radius-sm); padding: 0.5rem 0.75rem; font: inherit; font-weight: 700; font-size: var(--step--1); cursor: pointer; color: var(--ink); }
  .dl-change[aria-pressed='true'] { border-color: var(--ok); background: var(--ok-soft); cursor: default; }
  .dl-log { margin: 0.75rem 0 0; padding-left: 1.4rem; display: grid; gap: 0.3rem; font-size: var(--step--1); }
  .dl-kind { display: inline-block; padding: 0 0.4rem; border-radius: 999px; font-size: 0.8em; font-weight: 700; }
  .dl-kind--enhancement { background: color-mix(in srgb, var(--math) 18%, var(--surface)); }
  .dl-kind--refinement { background: color-mix(in srgb, var(--science) 18%, var(--surface)); }
  .dl-bottle { stroke: var(--ink); stroke-width: 2.5; stroke-linejoin: round; }
  .dl-water { fill: color-mix(in srgb, var(--math) 35%, transparent); }
  .dl-drip { fill: var(--math); }
</style>

<script>
  import { FACTORS, score, type Change, type Factor } from './design-lab.ts';

  class DesignLab extends HTMLElement {
    private changes: Change[] = [];
    private applied: string[] = [];

    connectedCallback() {
      this.changes = JSON.parse(this.dataset.changes!);
      this.querySelectorAll<HTMLButtonElement>('[data-dl-change]').forEach((b) =>
        b.addEventListener('click', () => {
          if (this.applied.includes(b.dataset.dlChange!)) return;
          this.applied.push(b.dataset.dlChange!);
          this.update(b.dataset.dlChange!);
        }),
      );
      this.querySelector('[data-dl="reset"]')!.addEventListener('click', () => {
        this.applied = [];
        this.querySelector('[data-dl="log"]')!.innerHTML = '';
        this.update();
      });
      this.update();
    }

    private update(latest?: string) {
      const s = score(this.applied);
      const before = score(this.applied.slice(0, -1));
      for (const f of FACTORS) {
        const bar = this.querySelector<HTMLElement>(`[data-dl-bar="${f}"]`)!;
        bar.style.width = `${(s[f] / 5) * 100}%`;
        bar.classList.toggle('is-down', !!latest && s[f] < before[f]);
        this.querySelector(`[data-dl-val="${f}"]`)!.textContent = `${s[f]}/5`;
      }
      this.querySelectorAll('[data-dl-change]').forEach((b) => b.setAttribute('aria-pressed', String(this.applied.includes(b.getAttribute('data-dl-change')!))));
      this.querySelector('[data-dl="version"]')!.textContent = `Version ${this.applied.length + 1}`;
      if (latest) {
        const c = this.changes.find((x) => x.id === latest)!;
        const effects = (Object.entries(c.effect) as [Factor, number][])
          .map(([f, v]) => `${f} ${v > 0 ? '↑' : '↓'}`)
          .join(', ');
        const li = document.createElement('li');
        li.innerHTML = `<strong>Version ${this.applied.length + 1}:</strong> ${c.label.toLowerCase()} <span class="dl-kind dl-kind--${c.kind}">${c.kind}</span> → ${effects}`;
        this.querySelector('[data-dl="log"]')!.append(li);
      }
      this.draw();
    }

    private draw() {
      const has = (id: string) => this.applied.includes(id);
      const body = has('colour') ? '#2bb3a3' : '#cfd6de';
      const wall = has('thin') ? 1.5 : 3.5;
      const out: string[] = [];
      out.push(`<path class="dl-bottle" style="fill:${body};stroke-width:${wall}" d="M70,70 Q70,58 82,56 L138,56 Q150,58 150,70 L156,222 Q156,236 142,236 L78,236 Q64,236 64,222 Z"/>`);
      out.push(`<path class="dl-water" d="M70,120 L150,120 L155,222 Q155,234 142,234 L78,234 Q65,234 65,222 Z"/>`);
      // Lid: a sharp corner until it is smoothed.
      out.push(has('edges') ? `<rect class="dl-bottle" style="fill:#4a5568" x="78" y="30" width="64" height="28" rx="9"/>` : `<path class="dl-bottle" style="fill:#4a5568" d="M76,58 L76,30 L144,30 L152,22 L144,58 Z"/>`);
      if (!has('seal')) out.push(`<circle class="dl-drip" cx="152" cy="66" r="4"/><circle class="dl-drip" cx="156" cy="80" r="3"/>`);
      if (has('handle')) out.push(`<path d="M150,80 Q190,88 190,130 Q190,170 153,172" fill="none" stroke="#4a5568" stroke-width="8" stroke-linecap="round"/>`);
      if (has('bumper')) out.push(`<rect x="60" y="214" width="100" height="26" rx="10" fill="#333"/>`);
      this.querySelector('[data-dl="art"]')!.innerHTML = out.join('');
    }
  }
  customElements.define('design-lab', DesignLab);
</script>
