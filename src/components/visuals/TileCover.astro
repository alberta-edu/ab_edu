---
// Area by tiling (MAT4-OI5-GQ1-LO1). "tile": cover the same rectangle with different units. Units
// that tile leave no gaps; circles leave gaps. The count depends on the unit (K1.1-K1.3, U1.4,
// S1.3-S1.5). "star": the diamonds of a star blanket slide into a strip and back. The pieces move,
// but the area stays the same (U1.3, S1.2).
import { REGION, UNITS, tiles, tileText, starPieces, DIAMOND, type UnitKind } from './tile-cover.ts';

interface Props {
  mode?: 'tile' | 'star';
  units?: UnitKind[];
}
const { mode = 'tile', units = ['square', 'big', 'triangle', 'rect', 'circle'] } = Astro.props;
const pieces = starPieces(200, 200, 30, 245);
---
<g4m-tile-cover data-mode={mode}>
  {
    mode === 'tile' ? (
      <>
        <div class="seg g4m-tc-units" role="group" aria-label="Choose a unit">
          {units.map((u, i) => <button type="button" data-tc-unit={u} aria-pressed={String(i === 0)}>{UNITS[u].label}</button>)}
        </div>
        <svg class="g4m-tc-svg" viewBox="0 0 280 200" role="img" aria-label="A rectangle being covered with units" data-tc="svg">
          <rect class="g4m-tc-region" x={REGION.x} y={REGION.y} width={REGION.w} height={REGION.h} />
          <g class="g4m-tc-tiles" data-tc="tiles"></g>
          <rect class="g4m-tc-edge" x={REGION.x} y={REGION.y} width={REGION.w} height={REGION.h} />
        </svg>
        <div class="control-row">
          <button type="button" class="btn btn--primary btn--small" data-tc="fill">Cover it</button>
        </div>
        <p class="g4m-tc-say" data-tc="say" aria-live="polite">Pick a unit, then press Cover it.</p>
      </>
    ) : (
      <>
        <svg class="g4m-tc-svg g4m-tc-star" viewBox="0 80 400 245" role="img" aria-label="A star made of 32 diamonds that can slide into a strip" data-tc="svg">
          {pieces.map((p, i) => <path class={`g4m-tc-dia g4m-tc-ring${p.ring}`} d={DIAMOND} style={`transform:${p.star}; transition-delay:${i * 18}ms`} data-star={p.star} data-row={p.row} />)}
        </svg>
        <div class="control-row">
          <button type="button" class="btn btn--primary btn--small" data-tc="swap">Slide into a strip</button>
        </div>
        <p class="g4m-tc-say" data-tc="say" aria-live="polite">32 diamonds make an eight-point star.</p>
      </>
    )
  }
</g4m-tile-cover>

<style is:global>
  g4m-tile-cover { display: block; }
  .g4m-tc-units { flex-wrap: wrap; margin-bottom: 0.5rem; }
  .g4m-tc-svg { display: block; width: 100%; max-width: 26rem; height: auto; margin-inline: auto; }
  .g4m-tc-region { fill: var(--surface-2); }
  .g4m-tc-edge { fill: none; stroke: var(--ink); stroke-width: 3; }
  .g4m-tc-tiles > * { fill: color-mix(in srgb, var(--math) 55%, var(--surface)); stroke: var(--surface); stroke-width: 2; transform-box: fill-box; transform-origin: center; animation: g4m-tc-in 0.25s ease-out both; }
  .g4m-tc-tiles > *:nth-child(even) { fill: color-mix(in srgb, var(--math) 75%, var(--surface)); }
  .g4m-tc-tiles.is-gappy ~ .g4m-tc-edge { stroke: var(--bad); }
  @keyframes g4m-tc-in { from { opacity: 0; transform: scale(0.6); } to { opacity: 1; transform: none; } }
  .g4m-tc-dia { stroke: var(--surface); stroke-width: 1.5; transform-box: view-box; transform-origin: 0 0; transition: transform 1.1s cubic-bezier(.3,.8,.3,1); }
  .g4m-tc-ring0 { fill: var(--sun); }
  .g4m-tc-ring1 { fill: var(--bad); }
  .g4m-tc-ring2 { fill: var(--math); }
  .g4m-tc-say { margin: 0.3rem 0 0; font-weight: 700; min-height: 2.6em; }
  @media (prefers-reduced-motion: reduce) { .g4m-tc-tiles > * { animation: none; } .g4m-tc-dia { transition: none; } }
</style>

<script>
  import { tiles, tileText, type UnitKind } from './tile-cover.ts';

  class TileCover extends HTMLElement {
    private unit: UnitKind = 'square';
    private strip = false;

    connectedCallback() {
      if (this.dataset.mode === 'star') {
        this.q('swap').addEventListener('click', () => {
          this.strip = !this.strip;
          this.querySelectorAll<SVGPathElement>('.g4m-tc-dia').forEach((p) => (p.style.transform = this.strip ? p.dataset.row! : p.dataset.star!));
          this.q('swap').textContent = this.strip ? 'Slide back into a star' : 'Slide into a strip';
          this.q('say').textContent = this.strip ? 'Still 32 diamonds. The pieces moved, so the area is the same.' : '32 diamonds make an eight-point star.';
        });
        return;
      }
      this.unit = (this.querySelector('[data-tc-unit]') as HTMLElement).dataset.tcUnit as UnitKind;
      this.querySelectorAll<HTMLButtonElement>('[data-tc-unit]').forEach((b) =>
        b.addEventListener('click', () => {
          this.querySelectorAll('[data-tc-unit]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          this.unit = b.dataset.tcUnit as UnitKind;
          this.q('tiles').innerHTML = '';
          this.q('say').textContent = 'Press Cover it.';
        }),
      );
      this.q('fill').addEventListener('click', () => {
        const shapes = tiles(this.unit);
        const g = this.q('tiles');
        g.classList.toggle('is-gappy', this.unit === 'circle');
        g.innerHTML = shapes.map((s, i) => s.replace(/^<(\w+)/, `<$1 style="animation-delay:${Math.min(i * 40, 1500)}ms"`)).join('');
        this.q('say').textContent = tileText(this.unit);
      });
    }

    private q(name: string) {
      return this.querySelector(`[data-tc="${name}"]`) as HTMLElement;
    }
  }
  customElements.define('g4m-tile-cover', TileCover);
</script>
