---
// The parts of a plant's transport system (SCI5-OI4-GQ1-LO1, K2.1-K2.4, S2.1). Tap a part to see
// its job, or cut across the stem to see the xylem and phloem in their bundles.
import { PLANT_VIEWBOX, PLANT_PARTS, PLANT_JOBS, PLANT_LABELS, stemBundles, type PlantPart } from './plant-svg.ts';
const parts = Object.keys(PLANT_PARTS) as PlantPart[];
const bundles = stemBundles();
---
<plant-parts>
  <div class="sci-pick" role="group" aria-label="Choose what to look at">
    <button type="button" data-pp-show="parts" aria-pressed="true">Parts of a plant</button>
    <button type="button" data-pp-show="inside" aria-pressed="false">Inside the stem</button>
  </div>

  <div data-pp-view="parts">
    <svg class="sci-svg pp-svg" viewBox={PLANT_VIEWBOX} role="img" aria-label="A plant with roots in the soil, a stem, and four leaves with veins.">
      <rect class="sci-sky" x="60" y="20" width="440" height="242" />
      <rect class="pt-soil" x="60" y="262" width="440" height="90" />
      {parts.map((p) => <g data-pp-part={p}><Fragment set:html={PLANT_PARTS[p]} /></g>)}
    </svg>
    <p class="sci-pick-label">Tap a part to see its job</p>
    <div class="sci-pick" role="group" aria-label="Parts of a plant">
      {parts.map((p) => <button type="button" data-pp-pick={p} aria-pressed="false">{PLANT_LABELS[p]}</button>)}
    </div>
    <p class="sci-say" aria-live="polite" data-pp="say">Water travels up from the roots, and sugars travel out from the leaves. Tap a part to see its job.</p>
  </div>

  <div data-pp-view="inside" hidden>
    <svg class="sci-svg pp-svg pp-cut" viewBox="0 0 400 300" role="img" aria-label="A stem cut across. The tubes run in bundles in a ring. In each bundle, the xylem is on the inside and the phloem is on the outside, near the skin.">
      <circle class="pp-skin" cx="150" cy="150" r="120" />
      <circle class="pp-core" cx="150" cy="150" r="108" />
      {bundles.map((b) => (
        <g>
          <ellipse class="pp-xylem" cx={b.xylem.x.toFixed(1)} cy={b.xylem.y.toFixed(1)} rx="7" ry="13" transform={`rotate(${b.angle.toFixed(0)} ${b.xylem.x.toFixed(1)} ${b.xylem.y.toFixed(1)})`} />
          <ellipse class="pp-phloem" cx={b.phloem.x.toFixed(1)} cy={b.phloem.y.toFixed(1)} rx="6" ry="12" transform={`rotate(${b.angle.toFixed(0)} ${b.phloem.x.toFixed(1)} ${b.phloem.y.toFixed(1)})`} />
        </g>
      ))}
      <g class="bd-label">
        <line x1={bundles[0].phloem.x + 6} y1={bundles[0].phloem.y - 4} x2="292" y2="96" />
        <text x="296" y="100">Phloem</text>
        <line x1={bundles[0].xylem.x + 2} y1={bundles[0].xylem.y + 8} x2="292" y2="196" />
        <text x="296" y="200">Xylem</text>
        <line x1="235" y1="65" x2="292" y2="40" />
        <text x="296" y="44">Skin</text>
      </g>
    </svg>
    <div class="bt-key" aria-hidden="true">
      <span><i class="bt-k pt-k--water"></i>Xylem (water)</span>
      <span><i class="bt-k pp-k--phloem"></i>Phloem (sugars)</span>
    </div>
    <p class="sci-say">The tubes run in bundles. In each bundle, the xylem is on the inside and the phloem is on the outside.</p>
  </div>
</plant-parts>

<style is:global>
  plant-parts { display: block; }
  plant-parts > .sci-pick { margin-bottom: 0.75rem; }
  .pp-svg { max-width: 34rem; margin-inline: auto; }
  .pp-cut { max-width: 26rem; background: var(--surface-2); }
  .pp-skin { fill: #2f6f2a; }
  .pp-core { fill: color-mix(in srgb, #9fd38f 70%, var(--surface)); }
  .pp-xylem { fill: #2b8fd6; stroke: #1a5f93; stroke-width: 1.5; }
  .pp-phloem { fill: #e08a1e; stroke: #8a5a10; stroke-width: 1.5; }
  .pp-k--phloem { background: #e08a1e; }
  .pp-cut .bd-label text { font-size: 20px; }
  [data-pp-part] { transition: opacity 0.3s; }
  [data-pp-part].pp-dim { opacity: 0.2; }
  [data-pp-part].pp-on { filter: drop-shadow(0 0 6px var(--accent)); }
</style>

<script>
  import { PLANT_JOBS, PLANT_LABELS } from './plant-svg.ts';

  class PlantParts extends HTMLElement {
    connectedCallback() {
      this.querySelectorAll<HTMLButtonElement>('[data-pp-show]').forEach((b) =>
        b.addEventListener('click', () => {
          this.querySelectorAll('[data-pp-show]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          this.querySelectorAll<HTMLElement>('[data-pp-view]').forEach((v) => (v.hidden = v.dataset.ppView !== b.dataset.ppShow));
        }),
      );
      this.querySelectorAll<HTMLButtonElement>('[data-pp-pick]').forEach((b) => b.addEventListener('click', () => this.pick(b.dataset.ppPick as keyof typeof PLANT_JOBS)));
    }

    private pick(part: keyof typeof PLANT_JOBS) {
      this.querySelectorAll<HTMLButtonElement>('[data-pp-pick]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.ppPick === part)));
      this.querySelectorAll<SVGGElement>('[data-pp-part]').forEach((g) => {
        // Veins sit on the leaves, so keep the leaves visible behind them.
        const on = g.dataset.ppPart === part || (part === 'veins' && g.dataset.ppPart === 'leaves');
        g.classList.toggle('pp-dim', !on);
        g.classList.toggle('pp-on', g.dataset.ppPart === part);
      });
      this.querySelector('[data-pp="say"]')!.textContent = `${PLANT_LABELS[part]}: ${PLANT_JOBS[part]}`;
    }
  }
  customElements.define('plant-parts', PlantParts);
</script>
