---
// Narrowing a research topic (LANENG5-OI8-GQ1-LO1, K3.2, S3.2). Each press drops the topic further
// down a funnel, until it is small enough to write about well.
import { mdInline } from '../../lib/render.ts';

interface Props {
  levels: { topic: string; note: string }[];
}
const { levels } = Astro.props;
const n = levels.length;
const data = levels.map((l) => ({ topic: l.topic, note: mdInline(l.note) }));
// Funnel bands get narrower going down.
const bands = levels.map((_, i) => {
  const w = (t: number) => 600 - t * 400;
  const h = 170 / n;
  const top = 10 + i * h;
  const wt = w(i / n);
  const wb = w((i + 1) / n);
  return `M${330 - wt / 2} ${top} H${330 + wt / 2} L${330 + wb / 2} ${top + h - 3} H${330 - wb / 2} Z`;
});
---
<topic-funnel data-levels={JSON.stringify(data)}>
  <svg class="sci-svg" viewBox="0 0 660 190" aria-hidden="true">
    {bands.map((d, i) => <path class="fnl-band" data-fnl-band={i} d={d}></path>)}
    {levels.map((l, i) => <text class="fnl-label" data-fnl-label={i} x="330" y={10 + (i + 0.5) * (170 / n) + 5} text-anchor="middle">{i + 1}</text>)}
  </svg>
  <p class="fnl-topic" data-fnl="topic" aria-live="polite"></p>
  <p class="fnl-note" data-fnl="note"></p>
  <div class="control-row">
    <button type="button" class="btn btn--ghost btn--small" data-fnl="back">▲ Wider</button>
    <button type="button" class="btn btn--primary btn--small" data-fnl="next">▼ Narrow it down</button>
  </div>
</topic-funnel>

<style is:global>
  topic-funnel { display: block; }
  .fnl-band { fill: var(--surface-3); transition: fill 0.3s; }
  .fnl-band.is-past { fill: var(--accent-soft); }
  .fnl-band.is-on { fill: var(--accent); }
  .fnl-label { fill: var(--ink-3); font-size: 15px; font-weight: 700; }
  .fnl-label.is-on { fill: var(--brand-ink); }
  @media (max-width: 40rem) {
    svg .fnl-label { font-size: 20px; }
  }
  .fnl-topic { margin: 0.6rem 0 0.2rem; font-size: var(--step-2); font-weight: 700; line-height: 1.25; }
  .fnl-note { margin: 0; min-height: 3rem; color: var(--ink-2); }
  @media (prefers-reduced-motion: reduce) { .fnl-band { transition: none; } }
</style>

<script>
  class TopicFunnel extends HTMLElement {
    private levels: { topic: string; note: string }[] = [];
    private at = 0;

    connectedCallback() {
      this.levels = JSON.parse(this.dataset.levels!);
      this.part('next').addEventListener('click', () => this.go(this.at + 1));
      this.part('back').addEventListener('click', () => this.go(this.at - 1));
      this.go(0);
    }

    private part(name: string) {
      return this.querySelector<HTMLElement>(`[data-fnl="${name}"]`)!;
    }

    private go(i: number) {
      this.at = Math.max(0, Math.min(this.levels.length - 1, i));
      this.querySelectorAll<SVGElement>('[data-fnl-band]').forEach((b) => {
        const k = Number(b.dataset.fnlBand);
        b.classList.toggle('is-on', k === this.at);
        b.classList.toggle('is-past', k < this.at);
      });
      this.querySelectorAll<SVGElement>('[data-fnl-label]').forEach((l) => l.classList.toggle('is-on', Number(l.dataset.fnlLabel) === this.at));
      this.part('topic').textContent = this.levels[this.at].topic;
      this.part('note').innerHTML = this.levels[this.at].note;
      (this.part('back') as HTMLButtonElement).disabled = this.at === 0;
      (this.part('next') as HTMLButtonElement).disabled = this.at === this.levels.length - 1;
    }
  }
  customElements.define('topic-funnel', TopicFunnel);
</script>
