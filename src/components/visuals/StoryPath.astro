---
// A story as a trail: a marker walks through the parts of a narrative (LANENG5-OI1-GQ1-LO1, K1.6).
// With a flash-forward switched on, the marker leaps ahead in time, then comes back (K3.4, K3.5).
import { mdInline } from '../../lib/render.ts';

interface Props {
  stages: { label: string; text: string }[];
  flash?: { after: number; text: string };
}
const { stages, flash } = Astro.props;
const W = 660;
const pts = stages.map((_, i) => {
  const x = 60 + (i * (W - 120)) / (stages.length - 1);
  const y = 170 - Math.sin((i / (stages.length - 1)) * Math.PI) * 110;
  return [Math.round(x), Math.round(y)];
});
const trail = pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x} ${y}`).join(' ');
const data = { pts, stages: stages.map((s) => ({ label: s.label, text: mdInline(s.text) })), flash: flash && { after: flash.after, text: mdInline(flash.text) } };
const leapFrom = flash && pts[flash.after];
const leapTo = flash && [W - 60, 40];
---
<story-path data-story={JSON.stringify(data)}>
  <svg class="sci-svg" viewBox={`0 0 ${W} 220`} aria-hidden="true">
    <rect class="sci-sky" width={W} height="220"></rect>
    <path class="stp-trail" d={trail}></path>
    {leapFrom && leapTo && <path class="stp-leap" data-stp="leap" d={`M${leapFrom[0]} ${leapFrom[1]} Q ${(leapFrom[0] + leapTo[0]) / 2} ${leapFrom[1] - 90} ${leapTo[0]} ${leapTo[1]}`}></path>}
    {leapTo && <g class="stp-future" data-stp="future"><circle cx={leapTo[0]} cy={leapTo[1]} r="16"></circle><text class="sci-small" x={leapTo[0]} y={leapTo[1] + 34} text-anchor="middle">the future</text></g>}
    {pts.map(([x, y], i) => (
      <g class="stp-stop" data-stop={i}>
        <circle cx={x} cy={y} r="13"></circle>
        <text class="stp-num" x={x} y={y + 5} text-anchor="middle">{i + 1}</text>
        <text class="sci-small" x={x} y={y + 32} text-anchor="middle">{stages[i].label.split(' ')[0]}</text>
      </g>
    ))}
    <circle class="stp-walker" data-stp="walker" r="8" cx={pts[0][0]} cy={pts[0][1] - 20}></circle>
  </svg>
  <div class="stp-card" aria-live="polite">
    <h3 data-stp="label"></h3>
    <p data-stp="text"></p>
  </div>
  <div class="control-row">
    <button type="button" class="btn btn--ghost btn--small" data-stp="back">◀ Back</button>
    <button type="button" class="btn btn--primary btn--small" data-stp="next">Next ▶</button>
    {flash && <label class="control"><input type="checkbox" data-stp="flash" /> Add a flash-forward</label>}
  </div>
  <noscript><ol>{stages.map((s) => <li><strong>{s.label}:</strong> <span set:html={mdInline(s.text)} /></li>)}</ol></noscript>
</story-path>

<style is:global>
  story-path { display: block; }
  .stp-trail { fill: none; stroke: var(--line-strong); stroke-width: 5; stroke-linecap: round; stroke-dasharray: 2 10; }
  .stp-leap { fill: none; stroke: var(--accent); stroke-width: 3; stroke-dasharray: 8 7; }
  .stp-future circle { fill: var(--accent-soft); stroke: var(--accent); stroke-width: 3; }
  .stp-stop circle { fill: var(--surface); stroke: var(--line-strong); stroke-width: 3; }
  .stp-stop.is-on circle { fill: var(--accent); stroke: var(--accent); }
  .stp-num { fill: var(--ink-2); font-size: 14px; font-weight: 700; }
  .stp-stop.is-on .stp-num { fill: var(--brand-ink); }
  .stp-walker { fill: var(--sun); stroke: var(--ink); stroke-width: 2; transition: cx 0.5s ease, cy 0.5s ease; }
  .stp-card { min-height: 6rem; margin-top: 0.6rem; padding: 0.8rem 1rem; border-radius: var(--radius-sm); background: var(--surface-2); }
  .stp-card.is-flash { background: var(--accent-soft); }
  .stp-card h3 { margin: 0 0 0.25rem; }
  .stp-card p { margin: 0; }
  @media (prefers-reduced-motion: reduce) { .stp-walker { transition: none; } }
</style>

<script>
  type Stage = { label: string; text: string };
  type Data = { pts: number[][]; stages: Stage[]; flash?: { after: number; text: string } };
  const FUTURE = [600, 40];

  class StoryPath extends HTMLElement {
    private data!: Data;
    private seq: number[] = []; // stage indexes in telling order; -1 is the flash-forward
    private at = 0;

    connectedCallback() {
      this.data = JSON.parse(this.dataset.story!);
      this.part('next').addEventListener('click', () => this.go(this.at + 1));
      this.part('back').addEventListener('click', () => this.go(this.at - 1));
      this.querySelector('[data-stp="flash"]')?.addEventListener('change', () => this.build());
      this.build();
    }

    private part(name: string) {
      return this.querySelector<HTMLElement>(`[data-stp="${name}"]`)!;
    }

    private build() {
      const on = this.querySelector<HTMLInputElement>('[data-stp="flash"]')?.checked;
      const { stages, flash } = this.data;
      this.seq = stages.flatMap((_, i) => (on && flash && i === flash.after ? [i, -1] : [i]));
      for (const name of ['leap', 'future']) this.querySelector<SVGElement>(`[data-stp="${name}"]`)?.toggleAttribute('hidden', !on);
      this.go(0);
    }

    private go(i: number) {
      this.at = Math.max(0, Math.min(this.seq.length - 1, i));
      const stage = this.seq[this.at];
      const { pts, stages, flash } = this.data;
      const [x, y] = stage === -1 ? FUTURE : pts[stage];
      const walker = this.part('walker');
      walker.setAttribute('cx', String(x));
      walker.setAttribute('cy', String(y - 20));
      const reached = new Set(this.seq.slice(0, this.at + 1));
      this.querySelectorAll<SVGElement>('[data-stop]').forEach((g) => g.classList.toggle('is-on', reached.has(Number(g.dataset.stop))));
      this.part('label').textContent = stage === -1 ? 'Flash-forward' : stages[stage].label;
      this.part('text').innerHTML = stage === -1 ? flash!.text : stages[stage].text;
      this.querySelector('.stp-card')!.classList.toggle('is-flash', stage === -1);
      (this.part('back') as HTMLButtonElement).disabled = this.at === 0;
      (this.part('next') as HTMLButtonElement).disabled = this.at === this.seq.length - 1;
    }
  }
  customElements.define('story-path', StoryPath);
</script>
