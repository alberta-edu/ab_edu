---
// Precise words (LANENG4-OI3-GQ1-LO1, S1.1, U1.1). A plain word sits at the start of a slider. Slide to
// swap it for more precise words, and watch the picture change with each one.
import { mdInline } from '../../lib/render.ts';

interface Props {
  sets: { plain: string; sentence: string; icon: string; words: { word: string; note: string; size?: number; move?: string }[] }[];
}
const { sets } = Astro.props;
for (const s of sets) if (!s.sentence.includes('___')) throw new Error(`word-shades: "${s.plain}" sentence needs ___`);
const data = sets.map((s) => ({ ...s, words: [{ word: s.plain, note: 'The plain word. It is fine, but it doesn’t say much.' }, ...s.words].map((w) => ({ ...w, note: mdInline(w.note) })) }));
---
<word-shades data-sets={JSON.stringify(data)}>
  <div class="sci-pick" role="group" aria-label="Choose a plain word">
    {sets.map((s, i) => <button type="button" data-ws-set={i} aria-pressed={String(i === 0)}>{s.plain}</button>)}
  </div>
  <div class="g4e-ws__stage">
    <span class="g4e-ws__icon" data-ws="icon" aria-hidden="true"></span>
  </div>
  <p class="g4e-ws__sentence" data-ws="sentence" aria-live="polite"></p>
  <label class="g4e-ws__slider">
    <span class="sr-only">More precise</span>
    <input type="range" min="0" max="3" step="1" value="0" data-ws="range" />
  </label>
  <p class="g4e-ws__note" data-ws="note"></p>
</word-shades>

<style is:global>
  word-shades { display: block; }
  .g4e-ws__stage { display: grid; place-items: center; height: 7.5rem; margin-top: 0.6rem; border-radius: var(--radius-sm); background: var(--surface-2); overflow: hidden; }
  .g4e-ws__icon { display: inline-block; font-size: 3rem; line-height: 1; transition: transform 0.4s ease; }
  .g4e-ws__icon.is-shake { animation: g4e-ws-shake 0.5s ease infinite; }
  .g4e-ws__icon.is-tiptoe { animation: g4e-ws-tiptoe 1.4s ease-in-out infinite; }
  .g4e-ws__icon.is-bounce { animation: g4e-ws-bounce 0.6s ease infinite; }
  @keyframes g4e-ws-shake { 25% { translate: -4px 0; } 75% { translate: 4px 0; } }
  @keyframes g4e-ws-tiptoe { 50% { translate: 18px -4px; } }
  @keyframes g4e-ws-bounce { 50% { translate: 0 -14px; } }
  @media (prefers-reduced-motion: reduce) { .g4e-ws__icon { transition: none; animation: none !important; } }
  .g4e-ws__sentence { margin: 0.7rem 0 0.3rem; font-size: var(--step-1); text-align: center; }
  .g4e-ws__sentence mark { background: var(--accent-soft); color: var(--ink); font-weight: 800; padding: 0 0.2em; border-radius: 5px; }
  .g4e-ws__slider { display: block; }
  .g4e-ws__slider input { width: 100%; accent-color: var(--accent); }
  .g4e-ws__note { margin: 0.4rem 0 0; padding: 0.6rem 0.8rem; border-radius: var(--radius-sm); background: var(--surface-2); min-height: 2.6rem; }
</style>

<script>
  type Word = { word: string; note: string; size?: number; move?: string };
  type Set = { plain: string; sentence: string; icon: string; words: Word[] };

  class WordShades extends HTMLElement {
    private sets: Set[] = [];
    private at = 0;

    connectedCallback() {
      this.sets = JSON.parse(this.dataset.sets!);
      const range = this.part<HTMLInputElement>('range');
      range.addEventListener('input', () => this.paint());
      this.querySelectorAll<HTMLButtonElement>('[data-ws-set]').forEach((b) =>
        b.addEventListener('click', () => {
          this.at = Number(b.dataset.wsSet);
          this.querySelectorAll('[data-ws-set]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          range.value = '0';
          this.paint();
        }),
      );
      this.paint();
    }

    private part<T extends HTMLElement = HTMLElement>(name: string) {
      return this.querySelector<T>(`[data-ws="${name}"]`)!;
    }

    private paint() {
      const set = this.sets[this.at];
      const range = this.part<HTMLInputElement>('range');
      range.max = String(set.words.length - 1);
      const w = set.words[Number(range.value)];
      range.setAttribute('aria-valuetext', w.word);
      const icon = this.part('icon');
      icon.textContent = set.icon;
      icon.style.transform = `scale(${w.size ?? 1})`;
      icon.className = `g4e-ws__icon${w.move ? ` is-${w.move}` : ''}`;
      this.part('sentence').innerHTML = set.sentence.replace('___', `<mark>${w.word}</mark>`);
      this.part('note').innerHTML = w.note;
    }
  }
  customElements.define('word-shades', WordShades);
</script>
