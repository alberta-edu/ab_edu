---
// Particle model simulator: the same particles as a solid, a liquid and a gas, showing
// arrangement, movement and attraction (Grade 5 SCI5-OI1-GQ1-LO1, K1.1-K1.5).
interface Props {
  start?: 'solid' | 'liquid' | 'gas';
}
const { start = 'solid' } = Astro.props;
const STATES = {
  solid: {
    label: 'Solid',
    example: 'like ice',
    arrangement: 'Close together',
    movement: 'Vibrate in place',
    attraction: 'Strongest',
    shape: 'Definite shape (from Grade 3)',
    level: 3,
  },
  liquid: {
    label: 'Liquid',
    example: 'like water',
    arrangement: 'Separated by spaces',
    movement: 'Slide past each other',
    attraction: 'In between',
    shape: 'Takes the shape of its container (from Grade 3)',
    level: 2,
  },
  gas: {
    label: 'Gas',
    example: 'like water vapour',
    arrangement: 'Separated by large spaces',
    movement: 'Constantly moving in all directions',
    attraction: 'Weakest',
    shape: 'Expands to fill its container (from Grade 3)',
    level: 1,
  },
};
---
<particle-model data-start={start} data-states={JSON.stringify(STATES)}>
  <div class="pm-layout">
    <div class="pm-stage">
      <canvas width="420" height="320" aria-hidden="true"></canvas>
      <p class="sr-only" aria-live="polite" data-pm="live"></p>
    </div>
    <dl class="pm-facts">
      <div class="pm-state">
        <dt class="sr-only">State</dt>
        <dd><strong data-pm="label">{STATES[start].label}</strong> <span class="muted" data-pm="example">{STATES[start].example}</span></dd>
      </div>
      <div><dt>Arrangement</dt><dd data-pm="arrangement">{STATES[start].arrangement}</dd></div>
      <div><dt>Movement</dt><dd data-pm="movement">{STATES[start].movement}</dd></div>
      <div>
        <dt>Attractive forces</dt>
        <dd>
          <span data-pm="attraction">{STATES[start].attraction}</span>
          <span class="pm-meter" aria-hidden="true"><span data-pm="meter" style={`width:${STATES[start].level * 33.3}%`}></span></span>
        </dd>
      </div>
      <div><dt>Shape</dt><dd data-pm="shape">{STATES[start].shape}</dd></div>
    </dl>
  </div>
  <div class="control-row">
    <div class="seg" role="group" aria-label="Choose a state">
      {Object.entries(STATES).map(([k, s]) => <button type="button" data-state={k} aria-pressed={String(k === start)}>{s.label}</button>)}
    </div>
    <label class="control"><input type="checkbox" data-pm="bonds" checked /> Show attractions</label>
    <button type="button" class="btn btn--ghost btn--small" data-pm="pause">Pause</button>
  </div>
</particle-model>

<style is:global>
  particle-model { display: block; }
  .pm-layout { display: grid; gap: 1rem; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); align-items: start; }
  @media (max-width: 40rem) { .pm-layout { grid-template-columns: 1fr; } }
  .pm-stage canvas { width: 100%; height: auto; display: block; border-radius: var(--radius-sm); background: var(--surface-2); }
  .pm-facts { margin: 0; display: grid; gap: 0.6rem; font-size: var(--step--1); }
  .pm-facts dt { font-weight: 700; color: var(--ink-3); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.05em; }
  .pm-facts dd { margin: 0; }
  .pm-state dd { font-size: var(--step-1); }
  .pm-state strong { color: var(--accent); }
  .pm-meter { display: block; height: 8px; margin-top: 0.3rem; border-radius: 999px; background: var(--surface-3); overflow: hidden; }
  .pm-meter > span { display: block; height: 100%; background: var(--accent); border-radius: inherit; transition: width 0.4s; }
</style>

<script>
  type State = 'solid' | 'liquid' | 'gas';
  interface P { x: number; y: number; vx: number; vy: number; hx: number; hy: number }

  const W = 420;
  const H = 320;
  const PAD = 14; // container wall inset
  const R = 8.5;
  const COLS = 9;
  const ROWS = 6;
  /** How lively each state's particles look (0-100). Not a temperature: heating is Grade 6. */
  const MOTION: Record<State, number> = { solid: 15, liquid: 50, gas: 85 };

  class ParticleModel extends HTMLElement {
    private ps: P[] = [];
    private temp = 15;
    private state: State = 'solid';
    private running = true;
    private raf = 0;
    private ctx!: CanvasRenderingContext2D;
    private colors = { particle: '#2f5fd0', bond: '#2f5fd0', wall: '#4a4858', glass: '#ffffff' };
    private states!: Record<State, Record<string, string | number>>;

    connectedCallback() {
      this.states = JSON.parse(this.dataset.states!);
      const canvas = this.querySelector('canvas')!;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      this.ctx = canvas.getContext('2d')!;
      this.ctx.scale(dpr, dpr);
      this.readColors();
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => this.readColors());
      new MutationObserver(() => this.readColors()).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

      this.makeLattice();
      const start = this.dataset.start as State;
      this.temp = MOTION[start];
      this.applyState(start, true);
      this.querySelectorAll<HTMLButtonElement>('[data-state]').forEach((b) =>
        b.addEventListener('click', () => {
          const s = b.dataset.state as State;
          this.temp = MOTION[s];
          this.applyState(s);
        }),
      );
      const pause = this.querySelector<HTMLButtonElement>('[data-pm="pause"]')!;
      pause.addEventListener('click', () => this.setRunning(!this.running));
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) this.setRunning(false);

      // Only animate while visible, to save battery.
      new IntersectionObserver(([e]) => {
        cancelAnimationFrame(this.raf);
        if (e.isIntersecting && this.running) this.loop();
      }).observe(canvas);
      this.draw();
    }

    private readColors() {
      const cs = getComputedStyle(this);
      this.colors = {
        particle: cs.getPropertyValue('--accent').trim() || '#2f5fd0',
        bond: cs.getPropertyValue('--accent').trim() || '#2f5fd0',
        wall: cs.getPropertyValue('--ink-2').trim() || '#4a4858',
        glass: cs.getPropertyValue('--surface').trim() || '#fff',
      };
      if (!this.running) this.draw();
    }

    private setRunning(on: boolean) {
      this.running = on;
      this.querySelector('[data-pm="pause"]')!.textContent = on ? 'Pause' : 'Play';
      cancelAnimationFrame(this.raf);
      if (on) this.loop();
      else this.draw();
    }


    /** Lattice "home" spots for the solid, centred on the container floor. */
    private latticeSpots() {
      const s = 2 * R + 3;
      const spots: { x: number; y: number }[] = [];
      const left = W / 2 - ((COLS - 1) * s) / 2;
      for (let r = 0; r < ROWS; r++)
        for (let c = 0; c < COLS; c++) spots.push({ x: left + c * s + (r % 2 ? s / 2 : 0) - s / 4, y: H - PAD - R - 2 - r * s * 0.9 });
      return spots;
    }

    private makeLattice() {
      this.ps = this.latticeSpots().map((p) => ({ x: p.x, y: p.y, vx: 0, vy: 0, hx: p.x, hy: p.y }));
    }

    private applyState(s: State, initial = false) {
      const changed = s !== this.state;
      if (changed && s === 'solid') {
        // Freeze: each particle claims the nearest free lattice spot, lowest particles first.
        const spots = this.latticeSpots();
        const taken = new Set<number>();
        [...this.ps]
          .sort((a, b) => b.y - a.y)
          .forEach((p) => {
            let best = -1;
            let bestD = Infinity;
            spots.forEach((sp, i) => {
              if (taken.has(i)) return;
              const d = (sp.x - p.x) ** 2 + (sp.y - p.y) ** 2;
              if (d < bestD) [best, bestD] = [i, d];
            });
            taken.add(best);
            p.hx = spots[best].x;
            p.hy = spots[best].y;
          });
      }
      this.state = s;
      if (initial && s !== 'solid') for (let i = 0; i < 120; i++) this.step();
      const info = this.states[s];
      for (const k of ['label', 'example', 'arrangement', 'movement', 'attraction', 'shape']) {
        this.querySelector(`[data-pm="${k}"]`)!.textContent = String(info[k]);
      }
      (this.querySelector('[data-pm="meter"]') as HTMLElement).style.width = `${Number(info.level) * 33.3}%`;
      this.querySelectorAll('[data-state]').forEach((b) => b.setAttribute('aria-pressed', String((b as HTMLElement).dataset.state === s)));
      if (changed || initial) {
        this.querySelector('[data-pm="live"]')!.textContent = `${info.label}: ${info.arrangement}. ${info.movement}.`;
      }
      if (!this.running) {
        for (let i = 0; i < 90; i++) this.step();
        this.draw();
      }
    }

    private step() {
      const t = this.temp / 100;
      const ps = this.ps;
      const s = this.state;
      const left = PAD + R;
      const right = W - PAD - R;
      const top = PAD + R;
      const bottom = H - PAD - R;

      for (let i = 0; i < ps.length; i++) {
        const a = ps[i];
        for (let j = i + 1; j < ps.length; j++) {
          const b = ps[j];
          const dx = b.x - a.x;
          const dy = b.y - a.y;
          const d = Math.hypot(dx, dy) || 0.01;
          let f = 0;
          if (d < 2 * R) f = -0.35 * (2 * R - d); // keep particles from overlapping
          else if (s === 'liquid' && d < 3.4 * R) f = 0.035 * (d - 2 * R); // weak attraction
          if (f) {
            const fx = (f * dx) / d;
            const fy = (f * dy) / d;
            a.vx += fx; a.vy += fy;
            b.vx -= fx; b.vy -= fy;
          }
        }
      }

      for (const p of ps) {
        if (s === 'solid') {
          p.vx += (p.hx - p.x) * 0.09 + (Math.random() - 0.5) * (0.6 + 2.2 * t);
          p.vy += (p.hy - p.y) * 0.09 + (Math.random() - 0.5) * (0.6 + 2.2 * t);
          p.vx *= 0.7;
          p.vy *= 0.7;
        } else if (s === 'liquid') {
          p.vy += 0.16;
          p.vx += (Math.random() - 0.5) * (0.9 + 1.5 * t);
          p.vy += (Math.random() - 0.5) * (0.6 + 1.0 * t);
          p.vx *= 0.9;
          p.vy *= 0.9;
        } else {
          const target = 2.2 + 4 * t;
          const sp = Math.hypot(p.vx, p.vy) || 0.01;
          const k = 1 + (target / sp - 1) * 0.08;
          p.vx = p.vx * k + (Math.random() - 0.5) * 0.3;
          p.vy = p.vy * k + (Math.random() - 0.5) * 0.3;
        }
        const max = s === 'gas' ? 9 : 4;
        const sp = Math.hypot(p.vx, p.vy);
        if (sp > max) { p.vx *= max / sp; p.vy *= max / sp; }
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < left) { p.x = left; p.vx = Math.abs(p.vx); }
        if (p.x > right) { p.x = right; p.vx = -Math.abs(p.vx); }
        if (p.y < top) { p.y = top; p.vy = Math.abs(p.vy); }
        if (p.y > bottom) { p.y = bottom; p.vy = -Math.abs(p.vy) * (s === 'gas' ? 1 : 0.3); }
      }

      // Particles never overlap: push any overlapping pair apart (a few passes settle a pile).
      for (let pass = 0; pass < 3; pass++) {
        for (let i = 0; i < ps.length; i++) {
          for (let j = i + 1; j < ps.length; j++) {
            const a = ps[i];
            const b = ps[j];
            const dx = b.x - a.x;
            const dy = b.y - a.y;
            const d = Math.hypot(dx, dy) || 0.01;
            const overlap = 2 * R + 0.5 - d;
            if (overlap <= 0) continue;
            const ox = (dx / d) * (overlap / 2);
            const oy = (dy / d) * (overlap / 2);
            a.x -= ox; a.y -= oy;
            b.x += ox; b.y += oy;
          }
        }
        for (const p of ps) {
          p.x = Math.min(right, Math.max(left, p.x));
          p.y = Math.min(bottom, Math.max(top, p.y));
        }
      }
    }

    private draw() {
      const c = this.ctx;
      c.clearRect(0, 0, W, H);
      // Container: open-topped box
      c.strokeStyle = this.colors.wall;
      c.lineWidth = 3;
      c.beginPath();
      c.moveTo(PAD - 2, PAD - 6);
      c.lineTo(PAD - 2, H - PAD + 2);
      c.lineTo(W - PAD + 2, H - PAD + 2);
      c.lineTo(W - PAD + 2, PAD - 6);
      c.stroke();
      if (this.state === 'gas') {
        // Closed lid so the gas stays in the container
        c.setLineDash([6, 5]);
        c.beginPath();
        c.moveTo(PAD - 2, PAD - 2);
        c.lineTo(W - PAD + 2, PAD - 2);
        c.stroke();
        c.setLineDash([]);
      }

      const show = this.querySelector<HTMLInputElement>('[data-pm="bonds"]')?.checked;
      if (show && this.state !== 'gas') {
        const reach = this.state === 'solid' ? 2 * R + 6 : 2 * R + 5;
        c.strokeStyle = this.colors.bond;
        c.globalAlpha = this.state === 'solid' ? 0.7 : 0.35;
        c.lineWidth = this.state === 'solid' ? 2.5 : 1.5;
        c.beginPath();
        for (let i = 0; i < this.ps.length; i++)
          for (let j = i + 1; j < this.ps.length; j++) {
            const a = this.ps[i];
            const b = this.ps[j];
            if (Math.hypot(a.x - b.x, a.y - b.y) < reach) {
              c.moveTo(a.x, a.y);
              c.lineTo(b.x, b.y);
            }
          }
        c.stroke();
        c.globalAlpha = 1;
      }
      for (const p of this.ps) {
        c.beginPath();
        c.arc(p.x, p.y, R, 0, Math.PI * 2);
        c.fillStyle = this.colors.particle;
        c.fill();
        c.beginPath();
        c.arc(p.x - R * 0.35, p.y - R * 0.35, R * 0.3, 0, Math.PI * 2);
        c.fillStyle = 'rgba(255,255,255,0.55)';
        c.fill();
      }
    }

    private loop = () => {
      this.step();
      this.draw();
      this.raf = requestAnimationFrame(this.loop);
    };
  }
  customElements.define('particle-model', ParticleModel);
</script>
