---
// Measuring mass with a balance scale and volume with a graduated cylinder or a measuring
// jug, in SI units (SCI5-OI1-GQ1-LO1, K2.2-K2.6, S2.1, S2.2).
const OBJECTS = [
  { id: 'apple', label: 'Apple', grams: 160 },
  { id: 'book', label: 'Book', grams: 650 },
  { id: 'flour', label: 'Bag of flour', grams: 1000 },
];
const MASSES = [1000, 500, 100, 50, 10];
const fmt = (g: number) => (g >= 1000 && g % 1000 === 0 ? `${g / 1000} kg` : `${g} g`);
interface Props {
  /** Which tool to show first. */
  mode?: 'mass' | 'volume';
}
const { mode = 'mass' } = Astro.props;
---
<measure-tools data-objects={JSON.stringify(OBJECTS)}>
  <div class="seg" role="group" aria-label="What to measure">
    <button type="button" data-mt-mode="mass" aria-pressed={String(mode === 'mass')}>Mass: balance scale</button>
    <button type="button" data-mt-mode="volume" aria-pressed={String(mode === 'volume')}>Volume: liquids</button>
  </div>

  <div data-mt-panel="mass" hidden={mode !== 'mass'}>
    <p class="sci-pick-label">Put on the left pan</p>
    <div class="sci-pick" role="group" aria-label="Object to measure">
      {OBJECTS.map((o, i) => <button type="button" data-mt-obj={o.id} aria-pressed={String(i === 0)}>{o.label}</button>)}
    </div>
    <svg class="sci-svg mt-svg" viewBox="0 0 560 270" aria-hidden="true" data-mt="balance"></svg>
    <p class="sci-pick-label">Add standard masses to the right pan</p>
    <div class="sci-pick" role="group" aria-label="Add a mass">
      {MASSES.map((g) => <button type="button" data-mt-add={g}>+ {fmt(g)}</button>)}
      <button type="button" data-mt-undo>Take one off</button>
    </div>
    <p class="sci-say" data-mt="mass-say" aria-live="polite"></p>
  </div>

  <div data-mt-panel="volume" hidden={mode !== 'volume'}>
    <p class="sci-pick-label">Choose a tool</p>
    <div class="sci-pick" role="group" aria-label="Measuring tool">
      <button type="button" data-mt-tool="cylinder" aria-pressed="true">Graduated cylinder (100 mL)</button>
      <button type="button" data-mt-tool="jug" aria-pressed="false">Measuring jug (1 L)</button>
    </div>
    <svg class="sci-svg mt-svg" viewBox="0 0 560 290" aria-hidden="true" data-mt="vessel"></svg>
    <div class="control-row">
      <label class="control">Pour <input type="range" min="0" max="100" step="2" value="46" data-mt="pour" /></label>
    </div>
    <p class="sci-say" data-mt="vol-say" aria-live="polite"></p>
  </div>
</measure-tools>

<style is:global>
  measure-tools { display: block; }
  measure-tools .seg { margin-bottom: 0.4rem; }
  .mt-svg { background: var(--surface-2); margin-top: 0.6rem; }
  .mt-pointer { stroke: var(--bad); stroke-width: 3; stroke-linecap: round; }
  .mt-book { fill: var(--math); stroke: var(--ink); stroke-width: 2; }
  .mt-bag { fill: #efe3c8; stroke: var(--ink); stroke-width: 2; }
  .mt-ok { fill: var(--ok); font-size: 16px; font-weight: 700; }
  .mt-eye-line { stroke: var(--bad); stroke-width: 2; stroke-dasharray: 5 4; }
  .mt-eye { fill: var(--surface); stroke: var(--ink); stroke-width: 2; }
</style>

<script>
  import { tween, ease, lerp } from '../experiments/anim.ts';

  type Obj = { id: string; label: string; grams: number };
  const fmt = (g: number) => (g >= 1000 && g % 1000 === 0 ? `${g / 1000} kg` : `${g} g`);
  const PIVOT = { x: 280, y: 96 };
  const ARM = 170;

  class MeasureTools extends HTMLElement {
    private objects: Obj[] = [];
    private obj!: Obj;
    private masses: number[] = [];
    private angle = 0;
    private tool: 'cylinder' | 'jug' = 'cylinder';

    connectedCallback() {
      this.objects = JSON.parse(this.dataset.objects!);
      this.obj = this.objects[0];
      this.querySelectorAll<HTMLButtonElement>('[data-mt-mode]').forEach((b) =>
        b.addEventListener('click', () => {
          this.querySelectorAll('[data-mt-mode]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          this.querySelectorAll<HTMLElement>('[data-mt-panel]').forEach((p) => (p.hidden = p.dataset.mtPanel !== b.dataset.mtMode));
        }),
      );
      this.querySelectorAll<HTMLButtonElement>('[data-mt-obj]').forEach((b) =>
        b.addEventListener('click', () => {
          this.querySelectorAll('[data-mt-obj]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          this.obj = this.objects.find((o) => o.id === b.dataset.mtObj)!;
          this.masses = [];
          this.balance();
        }),
      );
      this.querySelectorAll<HTMLButtonElement>('[data-mt-add]').forEach((b) =>
        b.addEventListener('click', () => {
          if (this.masses.length < 8) this.masses.push(Number(b.dataset.mtAdd));
          this.balance();
        }),
      );
      this.querySelector('[data-mt-undo]')!.addEventListener('click', () => {
        this.masses.pop();
        this.balance();
      });
      this.querySelectorAll<HTMLButtonElement>('[data-mt-tool]').forEach((b) =>
        b.addEventListener('click', () => {
          this.querySelectorAll('[data-mt-tool]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          this.tool = b.dataset.mtTool as 'cylinder' | 'jug';
          const pour = this.querySelector<HTMLInputElement>('[data-mt="pour"]')!;
          if (this.tool === 'jug') Object.assign(pour, { max: '1000', step: '50', value: '650' });
          else Object.assign(pour, { max: '100', step: '2', value: '46' });
          this.vessel();
        }),
      );
      this.querySelector('[data-mt="pour"]')!.addEventListener('input', () => this.vessel());
      this.drawBalance();
      this.balance();
      this.vessel();
    }

    private total() {
      return this.masses.reduce((a, b) => a + b, 0);
    }

    private balance() {
      const diff = this.total() - this.obj.grams;
      // Right side heavier → beam turns clockwise (right pan down).
      const target = Math.max(-1, Math.min(1, diff / 150)) * 14;
      const from = this.angle;
      tween(450, (t) => {
        this.angle = lerp(from, target, ease(t));
        this.drawBalance();
      });
      const name = this.obj.label.toLowerCase();
      const say = this.querySelector('[data-mt="mass-say"]')!;
      if (diff === 0)
        say.textContent = `Balanced! The mass of the ${name} is ${fmt(this.obj.grams)}${this.obj.grams === 1000 ? ' (1 kg = 1000 g)' : ''}.`;
      else if (diff < 0) say.textContent = `${fmt(this.total())} on the right pan. The ${name} side is lower, so it has more mass. Add more.`;
      else say.textContent = `${fmt(this.total())} on the right pan. The masses side is lower, so it has too much mass. Take one off.`;
    }

    private drawBalance() {
      const r = (this.angle * Math.PI) / 180;
      const L = { x: PIVOT.x - ARM * Math.cos(r), y: PIVOT.y - ARM * Math.sin(r) };
      const R = { x: PIVOT.x + ARM * Math.cos(r), y: PIVOT.y + ARM * Math.sin(r) };
      const pan = (p: { x: number; y: number }, inner: string) => {
        const py = p.y + 92;
        return `<line class="mt-chain" x1="${p.x}" y1="${p.y}" x2="${p.x - 54}" y2="${py}"/><line class="mt-chain" x1="${p.x}" y1="${p.y}" x2="${p.x + 54}" y2="${py}"/><path class="mt-pan" d="M${p.x - 62},${py} Q${p.x},${py + 26} ${p.x + 62},${py} Z"/><g transform="translate(${p.x.toFixed(1)} ${py.toFixed(1)})">${inner}</g>`;
      };
      const objSvg: Record<string, string> = {
        apple: '<circle class="mt-apple" cx="0" cy="-20" r="20"/><path class="mt-leaf" d="M2,-40 Q14,-50 20,-42 Q10,-36 2,-40 Z"/>',
        book: '<rect class="mt-book" x="-40" y="-22" width="80" height="22" rx="3"/>',
        flour: '<path class="mt-bag" d="M-28,0 L-30,-58 L-20,-64 L20,-64 L30,-58 L28,0 Z"/><text class="mt-mass-t" x="0" y="-30" text-anchor="middle">FLOUR</text>',
      };
      let stack = '';
      let y = 0;
      for (const g of this.masses) {
        const h = g >= 500 ? 20 : g >= 100 ? 15 : 11;
        const w = g >= 500 ? 46 : g >= 100 ? 36 : 26;
        y -= h;
        const x = -w / 2;
        stack += `<rect class="mt-mass" x="${x}" y="${y}" width="${w}" height="${h}" rx="3"/><text class="mt-mass-t" x="0" y="${y + h / 2 + 4}" text-anchor="middle">${fmt(g)}</text>`;
      }
      const balanced = this.total() === this.obj.grams && Math.abs(this.angle) < 0.5;
      this.querySelector('[data-mt="balance"]')!.innerHTML =
        `<path class="mt-post" d="M262,250 L298,250 L288,${PIVOT.y} L272,${PIVOT.y} Z"/><rect class="mt-post" x="210" y="248" width="140" height="10" rx="4"/>` +
        `<line class="mt-pointer" x1="${PIVOT.x}" y1="${PIVOT.y}" x2="${(PIVOT.x - 60 * Math.sin(r)).toFixed(1)}" y2="${(PIVOT.y + 60 * Math.cos(r)).toFixed(1)}"/>` +
        `<line class="mt-beam" x1="${L.x.toFixed(1)}" y1="${L.y.toFixed(1)}" x2="${R.x.toFixed(1)}" y2="${R.y.toFixed(1)}"/><circle class="mt-post" cx="${PIVOT.x}" cy="${PIVOT.y}" r="7"/>` +
        pan(L, objSvg[this.obj.id]) +
        pan(R, stack) +
        (balanced ? `<text class="mt-ok" x="${PIVOT.x}" y="40" text-anchor="middle">✓ Balanced</text>` : '');
    }

    private vessel() {
      const amount = Number(this.querySelector<HTMLInputElement>('[data-mt="pour"]')!.value);
      const jug = this.tool === 'jug';
      const max = jug ? 1000 : 100;
      const top = 40;
      const bottom = 262;
      const x0 = jug ? 220 : 250;
      const w = jug ? 130 : 64;
      const yOf = (v: number) => bottom - ((bottom - top) * v) / max;
      let ticks = '';
      const minor = jug ? 50 : 2;
      for (let v = minor; v <= max; v += minor) {
        const major = jug ? v % 100 === 0 : v % 10 === 0;
        const y = yOf(v);
        ticks += `<line class="mt-tick${major ? ' mt-tick--major' : ''}" x1="${x0 + w}" y1="${y}" x2="${x0 + w - (major ? 22 : 11)}" y2="${y}"/>`;
        if (major) ticks += `<text class="mt-num" x="${x0 + w + 8}" y="${y + 4}">${jug && v === 1000 ? '1 L' : `${v} mL`}</text>`;
      }
      const ly = yOf(amount);
      const liquid = amount > 0 ? `<rect class="mt-liquid" x="${x0 + 2}" y="${ly}" width="${w - 4}" height="${bottom - ly}"/>` : '';
      const eye = `<line class="mt-eye-line" x1="96" y1="${ly}" x2="${x0 + w + 4}" y2="${ly}"/><g transform="translate(78 ${ly})"><path class="mt-eye" d="M-16,0 Q0,-12 16,0 Q0,12 -16,0 Z"/><circle cx="4" cy="0" r="4" class="obj-window"/></g><text class="sci-small" x="78" y="${ly - 16}" text-anchor="middle">eye level</text>`;
      const glass = jug
        ? `<path class="sci-glass" d="M${x0},${top - 14} L${x0},${bottom + 2} L${x0 + w},${bottom + 2} L${x0 + w},${top - 14} M${x0},${top} L${x0 - 26},${top + 10} L${x0 - 26},${top + 120} L${x0},${top + 130}"/>`
        : `<path class="sci-glass" d="M${x0},${top - 16} L${x0},${bottom + 2} L${x0 + w},${bottom + 2} L${x0 + w},${top - 16}"/><rect class="mt-post" x="${x0 - 22}" y="${bottom + 2}" width="${w + 44}" height="8" rx="3"/>`;
      this.querySelector('[data-mt="vessel"]')!.innerHTML = liquid + glass + ticks + (amount > 0 ? eye : '');
      const say = this.querySelector('[data-mt="vol-say"]')!;
      say.textContent =
        amount === 0
          ? 'The container is empty. Move the slider to pour.'
          : `The top of the liquid is level with the ${amount} mL mark, so the volume is ${amount} mL${amount === 1000 ? ' (1000 mL = 1 L)' : ''}.`;
    }
  }
  customElements.define('measure-tools', MeasureTools);
</script>
