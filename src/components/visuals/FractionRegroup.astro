---
// "Group into wholes": unit-fraction pieces slide together into whole bars, showing how an
// improper fraction becomes a mixed number (MAT5-OI1-GQ5-LO1: S1.2, S1.3, S1.5).
import { regroupHtml, equationHtml } from './fraction-regroup.ts';

interface Props {
  presets?: [number, number][];
}
const { presets = [[11, 4], [7, 3], [13, 5], [9, 2]] } = Astro.props;
const [n, d] = presets[0];
---
<fraction-regroup data-n={n} data-d={d}>
  <div class="rg-top">
    <div class="seg" role="group" aria-label="Choose a fraction">
      {presets.map(([pn, pd], i) => <button type="button" data-n={pn} data-d={pd} aria-pressed={String(i === 0)}>{pn}/{pd}</button>)}
    </div>
    <button type="button" class="btn btn--primary btn--small" data-rg="toggle">▶ Group into wholes</button>
  </div>
  <p class="rg-say" data-rg="say" aria-live="polite">{n} pieces, each one {d === 2 ? 'half' : `1/${d}`} of a whole.</p>
  <div data-rg="stage" set:html={regroupHtml(n, d)} />
  <div class="rg-equation" data-rg="eq" set:html={equationHtml(n, d)} />
</fraction-regroup>

<style is:global>
  fraction-regroup { display: block; }
  .rg-top { display: flex; flex-wrap: wrap; gap: 0.6rem 1rem; align-items: center; justify-content: space-between; }
  .rg-say { margin: 0.75rem 0; font-weight: 700; color: var(--ink-2); min-height: 1.6em; }
  .rg-stage { position: relative; margin-top: 0.5rem; transition: height 0.4s; }
  .rg-piece {
    position: absolute; left: var(--lx); top: var(--ly); width: var(--w); height: 44px;
    display: grid; place-items: center; border-radius: 8px; background: var(--accent); color: var(--brand-ink);
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--ink) 25%, transparent);
    transition: left 0.7s cubic-bezier(.2,.8,.2,1), top 0.7s cubic-bezier(.2,.8,.2,1), border-radius 0.7s;
    transition-delay: calc(var(--i) * 70ms);
  }
  .rg-frac { display: inline-flex; flex-direction: column; align-items: center; font-weight: 700; font-size: 0.85rem; line-height: 1.05; }
  .rg-frac > span:first-child { border-bottom: 2px solid currentColor; padding: 0 0.15em; }
  .rg-outline, .rg-label { position: absolute; top: var(--gy); opacity: 0; transition: opacity 0.4s; }
  .rg-outline { left: 0; width: var(--w); height: 44px; border: 3px solid var(--ink); border-radius: 10px; margin: -3px; box-sizing: content-box; }
  .rg-label { left: var(--x); line-height: 44px; font-weight: 700; color: var(--ok); white-space: nowrap; }
  .rg-label--rest { color: var(--accent); }
  .is-grouped .rg-piece { left: var(--gx); top: var(--gy); border-radius: 2px; }
  .is-grouped .rg-outline, .is-grouped .rg-label { opacity: 1; transition-delay: 1.1s; }
  .rg-equation { display: flex; align-items: center; gap: 0.5rem; margin-top: 0.9rem; opacity: 0; transform: translateY(6px); transition: opacity 0.4s, transform 0.4s; }
  .is-grouped .rg-equation { opacity: 1; transform: none; transition-delay: 1.4s; }
  .rg-eq { font-size: 1.8rem; color: var(--ink-3); }
  .rg-whole { font-size: 2.2rem; font-weight: 700; color: var(--accent); }
  @media (prefers-reduced-motion: reduce) {
    .rg-piece, .rg-outline, .rg-label, .rg-equation { transition: none !important; }
  }
</style>

<script>
  import { regroupHtml, equationHtml } from './fraction-regroup.ts';

  class FractionRegroup extends HTMLElement {
    private grouped = false;

    connectedCallback() {
      this.q('[data-rg="toggle"]').addEventListener('click', () => this.setGrouped(!this.grouped));
      this.querySelectorAll<HTMLButtonElement>('.seg [data-n]').forEach((b) =>
        b.addEventListener('click', () => {
          this.querySelectorAll('.seg [data-n]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          this.load(Number(b.dataset.n), Number(b.dataset.d));
        }),
      );
    }

    private q(sel: string) {
      return this.querySelector(sel) as HTMLElement;
    }

    private load(n: number, d: number) {
      this.setGrouped(false, true);
      this.q('[data-rg="stage"]').innerHTML = regroupHtml(n, d);
      this.q('[data-rg="eq"]').innerHTML = equationHtml(n, d);
      this.dataset.n = String(n);
      this.dataset.d = String(d);
      this.q('[data-rg="say"]').textContent = `${n} pieces, each one 1/${d} of a whole.`;
    }

    private setGrouped(on: boolean, quiet = false) {
      this.grouped = on;
      this.classList.toggle('is-grouped', on);
      this.q('[data-rg="toggle"]').textContent = on ? '↺ Take apart' : '▶ Group into wholes';
      if (quiet) return;
      const n = Number(this.dataset.n);
      const d = Number(this.dataset.d);
      const w = Math.floor(n / d);
      const r = n % d;
      this.q('[data-rg="say"]').textContent = on
        ? `Every ${d} pieces make 1 whole: ${w} whole${w === 1 ? '' : 's'}${r ? ` and ${r}/${d} left over` : ''}.`
        : `${n} pieces, each one 1/${d} of a whole.`;
    }
  }
  customElements.define('fraction-regroup', FractionRegroup);
</script>
