---
// Place value chart from millions to thousandths, centred on the ones place. Arcs show the
// "mirror": tens ↔ tenths, hundreds ↔ hundredths, thousands ↔ thousandths
// (MAT5-OI1-GQ1-LO1: U1.1, S1.1, S1.2).
import { numberWords } from './number-words.ts';

interface Props {
  value?: string;
}
const { value = '3 456 078.125' } = Astro.props;
const [intPart, decPart = ''] = value.replace(/\s/g, '').split('.');
const digitAt = (k: number) => (k >= 0 ? [...intPart].reverse()[k] : decPart[-k - 1]);
const PLACES = [
  { k: 6, name: 'millions' },
  { k: 5, name: 'hundred thousands' },
  { k: 4, name: 'ten thousands' },
  { k: 3, name: 'thousands' },
  { k: 2, name: 'hundreds' },
  { k: 1, name: 'tens' },
  { k: 0, name: 'ones' },
  { k: -1, name: 'tenths' },
  { k: -2, name: 'hundredths' },
  { k: -3, name: 'thousandths' },
];
---
<place-value data-value={value}>
  <label class="pv-input">
    <span>Type a number</span>
    <input type="text" inputmode="decimal" value={value} data-pv="input" autocomplete="off" spellcheck="false" />
  </label>
  <div class="pv-scroll">
    <div class="pv-chart">
      <svg class="pv-arcs" viewBox="0 0 1000 70" preserveAspectRatio="none" aria-hidden="true" data-pv="arcs">
        {
          [1, 2, 3].map((d) => {
            // column centres: 10 columns of 100 units; ones is column index 6
            const x1 = (6 - d) * 100 + 50;
            const x2 = (6 + d) * 100 + 50;
            const h = 18 + d * 15;
            return <path class={`pv-arc pv-arc--${d}`} data-pair={d} d={`M${x1} 68 C ${x1} ${68 - h * 1.3}, ${x2} ${68 - h * 1.3}, ${x2} 68`} />;
          })
        }
      </svg>
      <div class="pv-grid" role="table" aria-label="Place value chart">
        <div role="row" class="pv-row pv-row--names">
          {PLACES.map((p) => <span role="columnheader" class={`pv-name${p.k === 0 ? ' pv-ones' : ''}`} data-k={p.k}>{p.name}</span>)}
        </div>
        <div role="row" class="pv-row pv-row--digits">
          {PLACES.map((p) => <span role="cell" class={`pv-digit${p.k === 0 ? ' pv-ones' : ''}${digitAt(p.k) === undefined ? ' is-empty' : ''}`} data-k={p.k} data-pv-digit tabindex="0">{digitAt(p.k) ?? '0'}</span>)}
        </div>
      </div>
      <span class="pv-point" aria-hidden="true">.</span>
    </div>
  </div>
  <p class="pv-words" data-pv="words" aria-live="polite">{numberWords(value)}</p>
  <p class="pv-detail" data-pv="detail">Tap a digit to see its value.</p>
</place-value>

<style is:global>
  place-value { display: block; }
  .pv-scroll { overflow-x: auto; padding-bottom: 0.25rem; }
  .pv-chart { position: relative; min-width: 33rem; }
  .pv-arcs { display: block; width: 100%; height: 3.5rem; }
  .pv-arc { fill: none; stroke-width: 3; stroke-linecap: round; }
  .pv-arc--1 { stroke: var(--math); }
  .pv-arc--2 { stroke: var(--l3); }
  .pv-arc--3 { stroke: var(--sun); }
  .pv-row { display: grid; grid-template-columns: repeat(10, 1fr); }
  .pv-name { padding: 0.35rem 0.1rem; font-size: 0.66rem; font-weight: 700; text-align: center; color: var(--ink-2); background: var(--surface-2); border: 1px solid var(--line); line-height: 1.2; display: grid; place-items: center; min-height: 3.2em; }
  .pv-digit { font-size: clamp(1.6rem, 1.2rem + 1.5vw, 2.3rem); font-weight: 700; text-align: center; padding: 0.4rem 0; border: 1px solid var(--line); background: var(--surface); cursor: pointer; font-variant-numeric: tabular-nums; min-height: 1.8em; }
  .pv-ones { background: var(--accent-soft) !important; }
  .pv-digit.is-on { outline: 3px solid var(--accent); outline-offset: -3px; }
  .pv-name.is-pair-1, .pv-digit.is-pair-1 { box-shadow: inset 0 -4px 0 var(--math); }
  .pv-name.is-pair-2, .pv-digit.is-pair-2 { box-shadow: inset 0 -4px 0 var(--l3); }
  .pv-name.is-pair-3, .pv-digit.is-pair-3 { box-shadow: inset 0 -4px 0 var(--sun); }
  .pv-digit.is-empty { color: transparent; }
  .pv-point { position: absolute; left: 70%; bottom: 0.15em; transform: translateX(-50%); font-size: 2.6rem; font-weight: 700; line-height: 1; color: var(--bad); pointer-events: none; }
  .pv-words { margin: 0.9rem 0 0.3rem; font-size: var(--step-1); font-weight: 700; color: var(--accent); }
  .pv-detail { margin: 0; color: var(--ink-2); }
</style>

<script>
  import { numberWords } from './number-words.ts';

  const NAMES: Record<number, string> = { 6: 'millions', 5: 'hundred thousands', 4: 'ten thousands', 3: 'thousands', 2: 'hundreds', 1: 'tens', 0: 'ones', [-1]: 'tenths', [-2]: 'hundredths', [-3]: 'thousandths' };
  const VALUE: Record<number, string> = { 6: '1 000 000', 5: '100 000', 4: '10 000', 3: '1 000', 2: '100', 1: '10', 0: '1', [-1]: '0.1', [-2]: '0.01', [-3]: '0.001' };

  class PlaceValue extends HTMLElement {
    private digits = new Map<number, string>();

    connectedCallback() {
      const input = this.querySelector<HTMLInputElement>('[data-pv="input"]')!;
      input.addEventListener('input', () => this.set(input.value));
      this.querySelectorAll<HTMLElement>('[data-pv-digit]').forEach((cell) => {
        cell.addEventListener('click', () => this.pick(Number(cell.dataset.k)));
        cell.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            this.pick(Number(cell.dataset.k));
          }
        });
      });
      this.set(input.value);
    }

    private set(raw: string) {
      const s = raw.replace(/[\s  ,]/g, '');
      const words = this.querySelector('[data-pv="words"]')!;
      const m = /^(\d{1,7})(?:\.(\d{0,3}))?$/.exec(s);
      if (!m) {
        words.textContent = 'Type a whole number up to 9 999 999, with up to 3 decimal places.';
        return;
      }
      const [, int, dec = ''] = m;
      this.digits.clear();
      [...int].reverse().forEach((d, k) => this.digits.set(k, d));
      [...dec].forEach((d, i) => this.digits.set(-(i + 1), d));
      this.querySelectorAll<HTMLElement>('[data-pv-digit]').forEach((cell) => {
        const d = this.digits.get(Number(cell.dataset.k));
        cell.textContent = d ?? '0';
        cell.classList.toggle('is-empty', d === undefined);
      });
      words.textContent = numberWords(dec ? `${int}.${dec}` : int);
      this.querySelector('[data-pv="detail"]')!.textContent = 'Tap a digit to see its value.';
      this.querySelectorAll('.is-on, [class*="is-pair"]').forEach((el) => el.classList.remove('is-on', 'is-pair-1', 'is-pair-2', 'is-pair-3'));
    }

    private pick(k: number) {
      this.querySelectorAll('.is-on, [class*="is-pair"]').forEach((el) => el.classList.remove('is-on', 'is-pair-1', 'is-pair-2', 'is-pair-3'));
      const d = this.digits.get(k);
      const cell = this.querySelector(`[data-pv-digit][data-k="${k}"]`)!;
      cell.classList.add('is-on');
      const detail = this.querySelector('[data-pv="detail"]')!;
      if (d === undefined) {
        detail.textContent = `There is no digit in the ${NAMES[k]} place.`;
        return;
      }
      let text = `The ${d} is in the ${NAMES[k]} place, so it is worth ${d} × ${VALUE[k]}.`;
      const pair = Math.abs(k);
      if (pair >= 1 && pair <= 3) {
        for (const kk of [pair, -pair]) this.querySelectorAll(`[data-k="${kk}"]`).forEach((el) => el.classList.add(`is-pair-${pair}`));
        text += ` Its mirror place is the ${NAMES[-k]}, ${pair} place${pair > 1 ? 's' : ''} on the other side of the ones.`;
      }
      detail.textContent = text;
    }
  }
  customElements.define('place-value', PlaceValue);
</script>
