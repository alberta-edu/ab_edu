---
// Conflict as a blocked path (LANENG6-OI1-GQ1-LO1, K3.4, K3.7, K3.8). The protagonist heads for a goal,
// and an antagonist (a person, a group or a force) stands in the way. Press Go and the protagonist runs
// into it, then the card names the kind of conflict.
import { mdInline } from '../../lib/render.ts';

interface Story {
  label: string;
  hero: string;
  heroIcon: string;
  goal: string;
  goalIcon: string;
  against: string;
  againstIcon: string;
  kind: 'individual' | 'group' | 'force';
  note: string;
}
interface Props {
  stories: Story[];
}
const { stories } = Astro.props;
const KIND = { individual: 'Against another person', group: 'Against a group', force: 'Against a force' };
const data = stories.map((s) => ({ ...s, kindLabel: KIND[s.kind], note: mdInline(s.note) }));
---
<conflict-map data-stories={JSON.stringify(data)}>
  <div class="sci-pick" role="group" aria-label="Choose a story">
    {stories.map((s, i) => <button type="button" data-cm-tab={i} aria-pressed={i === 0 ? 'true' : 'false'}>{s.label}</button>)}
  </div>
  <div class="g6e-cm-stage" aria-hidden="true">
    <div class="g6e-cm-road"></div>
    <div class="g6e-cm-spot g6e-cm-spot--hero"><span class="g6e-cm-icon" data-cm="heroIcon"></span></div>
    <div class="g6e-cm-spot g6e-cm-spot--against"><span class="g6e-cm-icon" data-cm="againstIcon"></span></div>
    <div class="g6e-cm-spot g6e-cm-spot--goal"><span class="g6e-cm-icon" data-cm="goalIcon"></span></div>
  </div>
  <div class="g6e-cm-labels">
    <p><span class="g6e-cm-role">Protagonist</span><span data-cm="hero"></span></p>
    <p><span class="g6e-cm-role">Antagonist</span><span data-cm="against"></span></p>
    <p><span class="g6e-cm-role">Goal</span><span data-cm="goal"></span></p>
  </div>
  <div class="control-row">
    <button type="button" class="btn btn--primary btn--small" data-cm="go">▶ Go for the goal</button>
  </div>
  <div class="g6e-cm-card" data-cm="card" aria-live="polite" hidden>
    <strong data-cm="kind"></strong>
    <p data-cm="note"></p>
  </div>
  <noscript>
    <ul>{stories.map((s) => <li><strong>{s.hero}</strong> wants {s.goal}. <strong>{s.against}</strong> gets in the way ({KIND[s.kind]}).</li>)}</ul>
  </noscript>
</conflict-map>

<style is:global>
  conflict-map { display: block; }
  .g6e-cm-stage { position: relative; height: 7.5rem; margin-top: 0.7rem; border-radius: var(--radius-sm); background: color-mix(in srgb, var(--math) 10%, var(--surface)); overflow: hidden; }
  .g6e-cm-road { position: absolute; left: 6%; right: 6%; top: 58%; height: 0.5rem; border-radius: 999px; background: repeating-linear-gradient(90deg, var(--line-strong) 0 14px, transparent 14px 24px); }
  .g6e-cm-spot { position: absolute; top: 50%; transform: translate(-50%, -50%); display: grid; place-items: center; width: 4.2rem; height: 4.2rem; border-radius: 50%; background: var(--surface); border: 3px solid var(--line-strong); }
  .g6e-cm-spot--hero { left: 16.7%; border-color: var(--accent); transition: left 0.9s cubic-bezier(0.5, 0, 0.75, 0); z-index: 2; }
  .g6e-cm-spot--against { left: 50%; border-color: var(--bad); }
  .g6e-cm-spot--goal { left: 83.3%; border-color: var(--ok); border-style: dashed; }
  .g6e-cm-icon { font-size: 2rem; line-height: 1; }
  conflict-map.is-going .g6e-cm-spot--hero { left: 38%; }
  conflict-map.is-blocked .g6e-cm-spot--hero { left: 32%; transition: left 0.35s ease-out; }
  conflict-map.is-blocked .g6e-cm-spot--against { animation: g6e-cm-shake 0.35s ease; }
  @keyframes g6e-cm-shake { 25% { transform: translate(-46%, -50%); } 75% { transform: translate(-54%, -50%); } }
  .g6e-cm-labels { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.5rem; margin-top: 0.5rem; }
  .g6e-cm-labels p { margin: 0; display: grid; gap: 0.1rem; font-size: var(--step--1); line-height: 1.3; text-align: center; }
  .g6e-cm-role { font-weight: 700; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.75rem; }
  .g6e-cm-card { margin-top: 0.6rem; padding: 0.7rem 0.9rem; border-radius: var(--radius-sm); background: var(--warn-soft); }
  .g6e-cm-card p { margin: 0.2rem 0 0; }
  @media (prefers-reduced-motion: reduce) {
    .g6e-cm-spot--hero, conflict-map.is-blocked .g6e-cm-spot--hero { transition: none; }
    conflict-map.is-blocked .g6e-cm-spot--against { animation: none; }
  }
</style>

<script>
  type Story = { hero: string; heroIcon: string; goal: string; goalIcon: string; against: string; againstIcon: string; kindLabel: string; note: string };

  class ConflictMap extends HTMLElement {
    private stories: Story[] = [];
    private timers: number[] = [];

    connectedCallback() {
      this.stories = JSON.parse(this.dataset.stories!);
      const tabs = [...this.querySelectorAll<HTMLButtonElement>('[data-cm-tab]')];
      tabs.forEach((t) =>
        t.addEventListener('click', () => {
          tabs.forEach((b) => b.setAttribute('aria-pressed', String(b === t)));
          this.show(Number(t.dataset.cmTab));
        }),
      );
      this.part('go').addEventListener('click', () => this.go());
      this.show(0);
    }

    private part(name: string) {
      return this.querySelector<HTMLElement>(`[data-cm="${name}"]`)!;
    }

    private show(i: number) {
      this.timers.forEach(clearTimeout);
      this.classList.remove('is-going', 'is-blocked');
      const s = this.stories[i];
      for (const k of ['hero', 'heroIcon', 'goal', 'goalIcon', 'against', 'againstIcon'] as const) this.part(k).textContent = s[k];
      this.part('kind').textContent = s.kindLabel;
      this.part('note').innerHTML = s.note;
      this.part('card').hidden = true;
      (this.part('go') as HTMLButtonElement).disabled = false;
    }

    private go() {
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      (this.part('go') as HTMLButtonElement).disabled = true;
      this.classList.remove('is-blocked');
      this.classList.add('is-going');
      this.timers = [
        window.setTimeout(() => {
          this.classList.add('is-blocked');
          this.part('card').hidden = false;
        }, still ? 0 : 900),
      ];
    }
  }
  customElements.define('conflict-map', ConflictMap);
</script>
