---
// One lesson block. Each block type has its own layout: reading passages read like a
// book, worked examples are numbered step cards, experiments follow predict-observe-explain.
import type { Concept, LessonBlock } from '../lib/schema.ts';
import { md, mdInline } from '../lib/render.ts';
import { passageSentences } from '../lib/problem-html.ts';
import FractionExplorer from './visuals/FractionExplorer.astro';
import ParticleModel from './visuals/ParticleModel.astro';
import LatLongMap from './visuals/LatLongMap.astro';
import InferenceEquation from './visuals/InferenceEquation.astro';
import VirtualExperiment from './experiments/VirtualExperiment.astro';

interface Props {
  block: LessonBlock;
  concept: Concept;
  /** Anchor id for blocks that appear in the table of contents. */
  anchor?: string;
}
const { block, anchor } = Astro.props;
const visuals = {
  'fraction-explorer': FractionExplorer,
  'particle-model': ParticleModel,
  'latlong-map': LatLongMap,
  'inference-equation': InferenceEquation,
};
const calloutIcon = { tip: '💡', mistake: '⚠️', connection: '🔗', try: '🧪', remember: '📌' } as const;
---
{
  block.type === 'section' && (
    <section class="lesson-block" aria-labelledby={anchor}>
      <h2 id={anchor}>{block.heading}</h2>
      <div class="prose" set:html={md(block.body)} />
    </section>
  )
}
{
  block.type === 'visual' &&
    (() => {
      const Visual = visuals[block.component];
      return (
        <section class="lesson-block" aria-labelledby={block.heading ? anchor : undefined}>
          {block.heading && <h2 id={anchor}>{block.heading}</h2>}
          <figure class="card visual" style="margin:0">
            <Visual {...block.props} />
            {block.caption && <figcaption class="visual__caption" set:html={md(block.caption)} />}
          </figure>
        </section>
      );
    })()
}
{
  block.type === 'example' && (
    <section class="lesson-block card example">
      <div class="example__label">Worked example</div>
      <h3 style="margin-top:0.25rem">{block.title}</h3>
      <div class="example__problem prose" set:html={md(block.problem)} />
      <ol class="steps">
        {block.steps.map((s) => (
          <li class="step" set:html={md(s)} />
        ))}
      </ol>
      {block.answer && <div class="example__answer" set:html={md(block.answer)} />}
    </section>
  )
}
{
  block.type === 'callout' && (
    <aside class={`lesson-block callout callout--${block.variant}`}>
      <div class="callout__title">
        <span aria-hidden="true">{calloutIcon[block.variant]}</span>
        {block.title}
      </div>
      <div class="prose" set:html={md(block.body)} />
    </aside>
  )
}
{
  block.type === 'table' && (
    <section class="lesson-block" aria-labelledby={block.heading ? anchor : undefined}>
      {block.heading && <h2 id={anchor}>{block.heading}</h2>}
      <div class="table-wrap">
        <table class="data-table">
          {block.caption && <caption>{block.caption}</caption>}
          <thead>
            <tr>
              {block.headers.map((h) => (
                <th scope="col">{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {block.rows.map((row) => (
              <tr>
                {row.map((cell, i) =>
                  i === 0 ? <th scope="row" set:html={mdInline(cell)} /> : <td set:html={mdInline(cell)} />,
                )}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )
}
{
  block.type === 'passage' && (
    <section class="lesson-block" aria-labelledby={anchor}>
      <article class="card passage" id={`passage-${block.id}`}>
        <div class="passage__form">{block.form}</div>
        <h2 class="passage__title" id={anchor}>
          {block.title}
        </h2>
        <div class="passage__body">
          {passageSentences(block).map((sentences, i) => (
            <p class="passage__para">
              <span class="passage__num" aria-hidden="true">
                {i + 1}
              </span>
              <span set:html={sentences.map((s) => mdInline(s.text)).join(' ')} />
            </p>
          ))}
        </div>
        {block.note && <div class="passage__note" set:html={md(block.note)} />}
      </article>
    </section>
  )
}
{block.type === 'experiment' && <VirtualExperiment block={block} anchor={anchor} />}
