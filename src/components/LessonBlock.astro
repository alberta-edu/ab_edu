---
// One lesson block. Each block type has its own layout so a lesson reads as a mix of
// visuals, tables, side-by-side cards and short text, never a wall of words.
import type { Concept, LessonBlock } from '../lib/schema.ts';
import { md, mdInline } from '../lib/render.ts';
import { passageSentences } from '../lib/problem-html.ts';
import { renderFigure } from '../lib/figures.ts';
import FractionExplorer from './visuals/FractionExplorer.astro';
import FractionRegroup from './visuals/FractionRegroup.astro';
import ParticleModel from './visuals/ParticleModel.astro';
import Globe from './visuals/Globe.astro';
import LatLongMap from './visuals/LatLongMap.astro';
import InferenceEquation from './visuals/InferenceEquation.astro';
import ColumnCalc from './visuals/ColumnCalc.astro';
import PlaceValue from './visuals/PlaceValue.astro';
import DecimalZoom from './visuals/DecimalZoom.astro';
import Divisibility from './visuals/Divisibility.astro';
import FractionAdd from './visuals/FractionAdd.astro';
import RatioExplorer from './visuals/RatioExplorer.astro';
import ExpressionSteps from './visuals/ExpressionSteps.astro';
import MysteryBags from './visuals/MysteryBags.astro';
import BalanceScale from './visuals/BalanceScale.astro';
import SymmetryExplorer from './visuals/SymmetryExplorer.astro';
import CoordinateGrid from './visuals/CoordinateGrid.astro';
import RectangleBuilder from './visuals/RectangleBuilder.astro';
import SequenceBuilder from './visuals/SequenceBuilder.astro';
import DataSorter from './visuals/DataSorter.astro';
import MeasureTools from './visuals/MeasureTools.astro';
import DensityBalance from './visuals/DensityBalance.astro';
import FlightForces from './visuals/FlightForces.astro';
import FloatLab from './visuals/FloatLab.astro';
import EnergyMap from './visuals/EnergyMap.astro';
import WeatherStation from './visuals/WeatherStation.astro';
import ClimateGraph from './visuals/ClimateGraph.astro';
import HarvestSim from './visuals/HarvestSim.astro';
import BodySystems from './visuals/BodySystems.astro';
import PlantTransport from './visuals/PlantTransport.astro';
import SeasonsOrbit from './visuals/SeasonsOrbit.astro';
import MoonPhases from './visuals/MoonPhases.astro';
import Aurora from './visuals/Aurora.astro';
import BlockCode from './visuals/BlockCode.astro';
import DesignLab from './visuals/DesignLab.astro';
import FairTest from './visuals/FairTest.astro';
import DataViews from './visuals/DataViews.astro';
import WeatherMap from './visuals/WeatherMap.astro';
import CivTimeline from './visuals/CivTimeline.astro';
import RiseFallCity from './visuals/RiseFallCity.astro';
import ThenNow from './visuals/ThenNow.astro';
import CardSort from './visuals/CardSort.astro';
import SocialScientists from './visuals/SocialScientists.astro';
import VillageCity from './visuals/VillageCity.astro';
import Nilometer from './visuals/Nilometer.astro';
import TradeMap from './visuals/TradeMap.astro';
import SocialPyramid from './visuals/SocialPyramid.astro';
import EmpireMap from './visuals/EmpireMap.astro';
import IssueInvestigator from './visuals/IssueInvestigator.astro';
import StoryPath from './visuals/StoryPath.astro';
import PageExplorer from './visuals/PageExplorer.astro';
import PoemReader from './visuals/PoemReader.astro';
import ScriptStage from './visuals/ScriptStage.astro';
import VoiceLab from './visuals/VoiceLab.astro';
import VoiceReach from './visuals/VoiceReach.astro';
import TalkItOut from './visuals/TalkItOut.astro';
import WordBuilder from './visuals/WordBuilder.astro';
import WordJourney from './visuals/WordJourney.astro';
import FigureLens from './visuals/FigureLens.astro';
import PerspectiveLens from './visuals/PerspectiveLens.astro';
import WritingPath from './visuals/WritingPath.astro';
import SentenceRhythm from './visuals/SentenceRhythm.astro';
import ShowDial from './visuals/ShowDial.astro';
import TopicFunnel from './visuals/TopicFunnel.astro';
import SentenceLab from './visuals/SentenceLab.astro';
import SpellBuilder from './visuals/SpellBuilder.astro';
import PunctLab from './visuals/PunctLab.astro';
import VirtualExperiment from './experiments/VirtualExperiment.astro';

interface Props {
  block: LessonBlock;
  concept: Concept;
  /** Unique id prefix for anything that needs an id. */
  uid: string;
}
const { block, uid } = Astro.props;
const visuals = {
  'story-path': StoryPath,
  'page-explorer': PageExplorer,
  'poem-reader': PoemReader,
  'script-stage': ScriptStage,
  'voice-lab': VoiceLab,
  'voice-reach': VoiceReach,
  'talk-it-out': TalkItOut,
  'word-builder': WordBuilder,
  'word-journey': WordJourney,
  'figure-lens': FigureLens,
  'perspective-lens': PerspectiveLens,
  'writing-path': WritingPath,
  'sentence-rhythm': SentenceRhythm,
  'show-dial': ShowDial,
  'topic-funnel': TopicFunnel,
  'sentence-lab': SentenceLab,
  'spell-builder': SpellBuilder,
  'punct-lab': PunctLab,
  'civ-timeline': CivTimeline,
  'rise-fall-city': RiseFallCity,
  'then-now': ThenNow,
  'card-sort': CardSort,
  'social-scientists': SocialScientists,
  'village-city': VillageCity,
  nilometer: Nilometer,
  'trade-map': TradeMap,
  'social-pyramid': SocialPyramid,
  'empire-map': EmpireMap,
  'issue-investigator': IssueInvestigator,
  'weather-map': WeatherMap,
  'data-views': DataViews,
  'fair-test': FairTest,
  'design-lab': DesignLab,
  'block-code': BlockCode,
  'aurora': Aurora,
  'moon-phases': MoonPhases,
  'seasons-orbit': SeasonsOrbit,
  'plant-transport': PlantTransport,
  'body-systems': BodySystems,
  'harvest-sim': HarvestSim,
  'climate-graph': ClimateGraph,
  'weather-station': WeatherStation,
  'energy-map': EnergyMap,
  'measure-tools': MeasureTools,
  'density-balance': DensityBalance,
  'flight-forces': FlightForces,
  'float-lab': FloatLab,
  'data-sorter': DataSorter,
  'sequence-builder': SequenceBuilder,
  'rectangle-builder': RectangleBuilder,
  'coordinate-grid': CoordinateGrid,
  'symmetry-explorer': SymmetryExplorer,
  'balance-scale': BalanceScale,
  'mystery-bags': MysteryBags,
  'expression-steps': ExpressionSteps,
  'ratio-explorer': RatioExplorer,
  'fraction-add': FractionAdd,
  divisibility: Divisibility,
  'decimal-zoom': DecimalZoom,
  'place-value': PlaceValue,
  'column-calc': ColumnCalc,
  'fraction-explorer': FractionExplorer,
  'fraction-regroup': FractionRegroup,
  'particle-model': ParticleModel,
  globe: Globe,
  'latlong-map': LatLongMap,
  'inference-equation': InferenceEquation,
};
const calloutIcon = { tip: '💡', mistake: '⚠️', remember: '📌' } as const;
---
{
  block.type === 'text' && (
    <div class="lb lb-text">
      {block.heading && <h3 class="lb-heading">{block.heading}</h3>}
      <div class="prose" set:html={md(block.body)} />
    </div>
  )
}
{
  block.type === 'visual' &&
    (() => {
      const Visual = visuals[block.component];
      return (
        <figure class="lb card visual">
          <Visual {...block.props} />
          {block.caption && <figcaption class="visual__caption" set:html={md(block.caption)} />}
        </figure>
      );
    })()
}
{
  block.type === 'figure' && (
    <figure class="lb lb-figure">
      <div class="lb-figure__art" set:html={renderFigure(block.figure)} />
      <figcaption class="visual__caption" set:html={md(block.caption)} />
    </figure>
  )
}
{
  block.type === 'compare' && (
    <div class="lb compare" style={`--cols:${block.columns.length}`}>
      {block.columns.map((col) => (
        <section class="compare__col">
          <h3 class="compare__title">{col.title}</h3>
          {col.figure && <div class="compare__figure" set:html={renderFigure(col.figure)} />}
          <div class="prose" set:html={md(col.body)} />
        </section>
      ))}
    </div>
  )
}
{
  block.type === 'example' && (
    <section class="lb card example">
      <div class="example__label">Worked example</div>
      <h3 class="example__title">{block.title}</h3>
      <div class="example__problem prose" set:html={md(block.problem)} />
      <ol class="steps">
        {block.steps.map((s) => (
          <li class="step" set:html={md(s)} />
        ))}
      </ol>
      {block.answer && <div class="example__answer" set:html={md(block.answer)} />}
    </section>
  )
}
{
  block.type === 'callout' && (
    <div class={`lb callout callout--${block.variant}`} role="note">
      <div class="callout__title">
        <span aria-hidden="true">{calloutIcon[block.variant]}</span>
        {block.title}
      </div>
      <div class="prose" set:html={md(block.body)} />
    </div>
  )
}
{
  block.type === 'table' && (
    <div class="lb table-wrap">
      <table class="data-table">
        {block.caption && <caption set:html={mdInline(block.caption)} />}
        <thead>
          <tr>
            {block.headers.map((h) => (
              <th scope="col" set:html={mdInline(h)} />
            ))}
          </tr>
        </thead>
        <tbody>
          {block.rows.map((row) => (
            <tr>
              {row.map((cell, i) => (i === 0 ? <th scope="row" set:html={mdInline(cell)} /> : <td set:html={mdInline(cell)} />))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}
{
  block.type === 'passage' && (
    <article class="lb card passage" id={`passage-${block.id}`} aria-labelledby={`${uid}-title`}>
      <div class="passage__form">{block.form}</div>
      <h3 class="passage__title" id={`${uid}-title`}>
        {block.title}
      </h3>
      <div class="passage__body">
        {passageSentences(block).map((sentences, i) => (
          <p class="passage__para">
            <span class="passage__num" aria-hidden="true">
              {i + 1}
            </span>
            <span set:html={sentences.map((s) => mdInline(s.text)).join(' ')} />
          </p>
        ))}
      </div>
      {block.note && <div class="passage__note" set:html={md(block.note)} />}
    </article>
  )
}
{block.type === 'experiment' && <VirtualExperiment block={block} uid={uid} />}
